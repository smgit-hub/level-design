# Copy this file to .env for local development (and set the same names in the Netlify dashboard for deploys).
# Never commit the real values.

# --- Stripe (Studio Collection checkout) ---
# This Stripe account is shared with other sites, so use RESTRICTED keys (rk_test_… locally; rk_live_… in Netlify only, once you are ready for real orders).
# The site itself (checkout + order email) needs: Checkout Sessions = Write, Prices = Read, Products = Read.
# `npm run stripe:setup` needs Products = Write and Prices = Write — use a separate, short-lived key for that and delete it afterwards.
STRIPE_SECRET_KEY=
# The private delivery-quote page (/admin/quote/) also needs: Payment Links = Write, Shipping Rates = Write (on top of the above).
# The webhook signing secret (whsec_…) for the endpoint that points at /.netlify/functions/stripe-webhook
STRIPE_WEBHOOK_SECRET=

# --- Delivery quote page (/admin/quote/) ---
# The passphrase typed on that page. Pick something long; it is the only thing protecting the page's payment-link maker.
QUOTE_ADMIN_KEY=

# --- Order emails (sent through Brevo when a payment completes) ---
# A sender address you have verified in Brevo, and the inbox that should receive order emails.
BREVO_SENDER_EMAIL=
ORDER_NOTIFICATION_EMAIL=

# --- Brevo (newsletter signup + order emails) ---
BREVO_API_KEY=
BREVO_LIST_ID=
# The id of a Brevo double opt-in confirmation template (its button uses {{ doubleoptin }}). Once this and BREVO_LIST_ID are
# set, newsletter signups must confirm by email before they're added; until then they're added straight away.
BREVO_DOI_TEMPLATE_ID=
