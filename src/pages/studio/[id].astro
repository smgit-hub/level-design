---
import Layout from '../../layouts/Layout.astro';
import StudioProductDetailClient from '../../components/StudioProductDetailClient';
import { allStudioProducts } from '../../data/studio-products';

export function getStaticPaths() {
  return allStudioProducts.map((p) => ({
    params: { id: p.id },
    props: { product: p },
  }));
}

const { product } = Astro.props;
const index = allStudioProducts.findIndex((p) => p.id === product.id);
const prev = allStudioProducts[(index - 1 + allStudioProducts.length) % allStudioProducts.length];
const next = allStudioProducts[(index + 1) % allStudioProducts.length];
const productUrl = `/studio/${product.id}/`;
const pageDescription = `${product.name} — ${product.tagline}. Same design standard as our Signature Collection, at a more accessible price — a set of fixed sizes, ready to order online.`;

const formatPrice = (cents: number) =>
  new Intl.NumberFormat('en-AU', { style: 'currency', currency: 'AUD', maximumFractionDigits: 0 }).format(cents / 100);
const sizePrices = product.sizes.map((s) => s.price);
const lowPrice = Math.min(...sizePrices);
const highPrice = Math.max(...sizePrices);

const productFaqs = [
  {
    question: `What is ${product.name} made from?`,
    answer: `${product.name} is built with a real oak veneer top over a stable substrate, with solid oak wherever the table bears weight — built to last, not to be replaced.`,
  },
  {
    question: `What sizes is ${product.name} available in?`,
    answer: `${product.name} comes in ${product.sizes.length} fixed sizes: ${product.sizes.map((s) => `${s.label} (${formatPrice(s.price)})`).join(', ')}.`,
  },
  {
    question: `Can I get a different size?`,
    answer: `${product.name} is available in the sizes above to keep it accessible. For a size outside that range, the Signature Collection or a custom commission would be a better fit.`,
  },
  {
    question: `How is ${product.name} delivered, and what does delivery cost?`,
    answer: `Delivery is $199 for Melbourne Metro, or $449 for other Australian capital cities and VIC regional areas — both are calculated at checkout. For remote areas (WA, NT, TAS, and far regional addresses), checkout completes without a delivery charge and we'll confirm the fee and invoice it separately.`,
  },
];
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: product.name,
    description: pageDescription,
    image: [product.images.main, ...product.images.gallery].map((image: string) => new URL(image, Astro.site ?? Astro.url.origin).toString()),
    category: 'Timber dining table',
    brand: {
      '@type': 'Brand',
      name: 'Level Design',
    },
    manufacturer: {
      '@type': 'Organization',
      name: 'Level Design',
    },
    url: new URL(productUrl, Astro.site ?? Astro.url.origin).toString(),
    material: product.specifications['Construction'],
    offers: {
      '@type': 'AggregateOffer',
      lowPrice: (lowPrice / 100).toFixed(2),
      highPrice: (highPrice / 100).toFixed(2),
      offerCount: product.sizes.length,
      priceCurrency: 'AUD',
      availability: 'https://schema.org/InStock',
      url: new URL(productUrl, Astro.site ?? Astro.url.origin).toString(),
    },
    additionalProperty: Object.entries(product.specifications).map(([name, value]) => ({
      '@type': 'PropertyValue',
      name,
      value,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: new URL('/', Astro.site ?? Astro.url.origin).toString(),
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Studio',
        item: new URL('/studio/', Astro.site ?? Astro.url.origin).toString(),
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: product.name,
        item: new URL(productUrl, Astro.site ?? Astro.url.origin).toString(),
      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: productFaqs.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
];
---

<Layout
  title={`${product.name} | Studio Collection Dining Table Melbourne | Level Design`}
  description={pageDescription}
  ogImage={product.images.main}
  ogType="product"
  schema={schema}
>
  <StudioProductDetailClient product={product} prev={{ id: prev.id, name: prev.name }} next={{ id: next.id, name: next.name }} client:load />

  <section class="py-20 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="reveal bg-[#f5f1e8] rounded-3xl p-8 md:p-10">
        <h2 class="text-3xl font-serif text-[#3d4f47] mb-8">{product.name} FAQs</h2>
        <div class="space-y-6">
          {productFaqs.map((item) => (
            <div class="border-b border-[#d9cfbd] pb-6 last:border-b-0 last:pb-0">
              <h3 class="text-xl font-semibold text-[#3d4f47] mb-3">{item.question}</h3>
              <p class="text-[#5a6b64] leading-relaxed">{item.answer}</p>
            </div>
          ))}
        </div>
      </div>

      <div class="reveal mt-12 text-center" style="--delay: 0.15s">
        <p class="text-[#5a6b64] text-lg mb-6">Comparing options? Explore the full <a href="/studio/" class="text-[#c8956a] hover:underline">Studio Collection</a> or the <a href="/signature/" class="text-[#c8956a] hover:underline">Signature Collection</a> for a bespoke commission.</p>
      </div>
    </div>
  </section>
</Layout>
