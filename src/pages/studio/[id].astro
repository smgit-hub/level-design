---
import Layout from '../../layouts/Layout.astro';
import StudioProductDetailClient from '../../components/StudioProductDetailClient';
import StudioShapeIcon from '../../components/StudioShapeIcon.astro';
import { allStudioProducts, startingPrice } from '../../data/studio-products';

export function getStaticPaths() {
  return allStudioProducts.map((p) => ({
    params: { id: p.id },
    props: { product: p },
  }));
}

const { product } = Astro.props;
const otherProducts = allStudioProducts.filter((p) => p.id !== product.id);
const productUrl = `/studio/${product.id}/`;
const pageDescription = `${product.name} — ${product.tagline}. Same design standard as our Signature Collection, at a more accessible price — a set of fixed sizes, ready to order online.`;

const formatPrice = (cents: number) =>
  new Intl.NumberFormat('en-AU', { style: 'currency', currency: 'AUD', maximumFractionDigits: 0 }).format(cents / 100);
const sizePrices = product.sizes.map((s) => s.price);
const lowPrice = Math.min(...sizePrices);
const highPrice = Math.max(...sizePrices);

const productFaqs = [
  {
    question: `What is ${product.name} made from?`,
    answer: `${product.name} is built with ${product.construction} — made to last for years of daily use.`,
  },
  {
    question: `What sizes is ${product.name} available in?`,
    answer: `${product.name} comes in ${product.sizes.length} fixed sizes: ${product.sizes.map((s) => `${s.label} (${formatPrice(s.price)})`).join(', ')}.`,
  },
  {
    question: `Can I get a different size?`,
    answer: `${product.name} is available in the sizes above to keep it accessible. For a size outside that range, the Signature Collection or a custom commission would be a better fit.`,
  },
  {
    question: `How is ${product.name} delivered, and what does delivery cost?`,
    answer: `Delivery is $199 for Melbourne Metro, or $449 for other Australian capital cities and VIC regional areas — both are calculated at checkout. For remote areas (WA, NT, TAS, and far regional addresses), checkout completes without a delivery charge and we'll confirm the fee and invoice it separately.`,
  },
];
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: product.name,
    description: pageDescription,
    image: [...product.images.gallery, product.images.main].map((image: string) => new URL(image, Astro.site ?? Astro.url.origin).toString()),
    category: 'Timber dining table',
    brand: {
      '@type': 'Brand',
      name: 'Level Design',
    },
    manufacturer: {
      '@type': 'Organization',
      name: 'Level Design',
    },
    url: new URL(productUrl, Astro.site ?? Astro.url.origin).toString(),
    material: product.specifications['Construction'],
    offers: {
      '@type': 'AggregateOffer',
      lowPrice: (lowPrice / 100).toFixed(2),
      highPrice: (highPrice / 100).toFixed(2),
      offerCount: product.sizes.length,
      priceCurrency: 'AUD',
      availability: 'https://schema.org/InStock',
      url: new URL(productUrl, Astro.site ?? Astro.url.origin).toString(),
    },
    additionalProperty: Object.entries(product.specifications).map(([name, value]) => ({
      '@type': 'PropertyValue',
      name,
      value,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: new URL('/', Astro.site ?? Astro.url.origin).toString(),
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Studio',
        item: new URL('/studio/', Astro.site ?? Astro.url.origin).toString(),
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: product.name,
        item: new URL(productUrl, Astro.site ?? Astro.url.origin).toString(),
      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: productFaqs.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
];
---

<Layout
  title={`${product.name} | Studio Collection Dining Table Melbourne | Level Design`}
  description={pageDescription}
  ogImage={product.images.gallery[0] ?? product.images.main}
  ogType="product"
  schema={schema}
>
  <StudioProductDetailClient product={product} client:load />

  <section class="pt-0 pb-16 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="reveal bg-[#f5f1e8] rounded-3xl p-6 md:p-10">
        <h2 class="text-3xl font-serif text-[#3d4f47] mb-6">{product.name} FAQs</h2>
        <div class="divide-y divide-[#d9cfbd]">
          {productFaqs.map((item, i) => (
            <details class="group py-4" open={i === 0}>
              <summary class="flex items-center justify-between gap-4 cursor-pointer list-none text-lg font-semibold text-[#3d4f47] [&::-webkit-details-marker]:hidden">
                {item.question}
                <svg class="w-5 h-5 flex-shrink-0 text-[#c8956a] transition-transform duration-200 group-open:rotate-180" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 8l5 5 5-5" /></svg>
              </summary>
              <p class="text-[#5a6b64] leading-relaxed mt-3">{item.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section id="studio-other-tables" class="py-16 bg-[#faf8f5]">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-serif text-[#3d4f47] mb-8 text-center">Other Studio tables</h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        {otherProducts.map((other) => (
          <a href={`/studio/${other.id}/`} class="group flex sm:block bg-white rounded-2xl overflow-hidden border border-[#e5ddd0] hover:border-[#c8956a] transition-colors">
            <div class="w-28 flex-shrink-0 aspect-square sm:w-full sm:aspect-[4/3] overflow-hidden">
              <img
                src={other.images.gallery[0] ?? other.images.main}
                alt={other.name}
                loading="lazy"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
            </div>
            <div class="p-4 flex flex-col justify-center">
              <h3 class="font-serif text-xl text-[#3d4f47]">{other.name}</h3>
              <p class="flex items-center gap-2 text-sm text-[#5a6b64] mt-1"><StudioShapeIcon product={other} class="w-8" /><span>{other.shape}</span></p>
              <p class="text-sm font-semibold text-[#c8956a] mt-1">From {formatPrice(startingPrice(other))}</p>
            </div>
          </a>
        ))}
      </div>
      <p class="mt-8 text-center"><a href="/studio/" class="text-[#3d4f47] font-medium underline underline-offset-4 hover:text-[#c8956a] transition-colors">View all Studio tables</a></p>
      <p class="text-[#5a6b64] mt-6 text-center">Looking for something bespoke? Explore the <a href="/signature/" class="text-[#c8956a] hover:underline">Signature Collection</a>.</p>
    </div>
  </section>
</Layout>
