---
import Layout from '../../layouts/Layout.astro';
import { allStudioProducts, startingPrice as getStartingPrice } from '../../data/studio-products';
import StudioShapeIcon from '../../components/StudioShapeIcon.astro';

const formatPrice = (cents: number) =>
  new Intl.NumberFormat('en-AU', { style: 'currency', currency: 'AUD', maximumFractionDigits: 0 }).format(cents / 100);

const startingPrice = Math.min(...allStudioProducts.map(getStartingPrice));

const faqs = [
  {
    question: 'How is the Studio Collection different from the Signature Collection?',
    answer:
      'Both are the same standard of craft. Studio tables are sold in a set of fixed sizes at a more accessible price, with no design consultation needed. Signature tables are a fully bespoke commission, made to order and discussed with you directly.',
  },
  {
    question: 'What are Studio tables made from?',
    answer:
      'Every Studio table is built with real oak veneer over a stable substrate — made to last for years of daily use. The Line Table adds a fully solid oak base.',
  },
  {
    question: 'What sizes are Studio tables available in?',
    answer:
      'The Line Table comes in three fixed sizes — 1600mm, 2000mm, and 2350mm. Curve and Pill come in 2000mm and 2350mm, and the Round Table comes in 1200mm and 1500mm diameters. Pricing is shown for each size on the table\'s page. For a size outside that range, the Signature Collection or a custom commission is the better fit.',
  },
  {
    question: 'How long does delivery take?',
    answer:
      'Studio tables are still made to order, so please allow 6–8 weeks for production — faster and more predictable than a bespoke commission since there\'s no design consultation phase. We\'ll be in touch after checkout to confirm the timeline.',
  },
  {
    question: 'How much does delivery cost?',
    answer:
      'Delivery is $199 for Melbourne Metro, or $449 for other Australian capital cities and VIC regional areas — both are added automatically at checkout. For remote areas (WA, NT, TAS, and far regional addresses), checkout completes without a delivery charge and we\'ll confirm the fee and invoice it separately.',
  },
  {
    question: 'How does checkout work?',
    answer:
      'Buying a Studio table takes you to a secure Stripe checkout page to complete payment. You’ll receive an order confirmation by email immediately after.',
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};
---

<Layout
  title="Studio Collection | Considered Design, Ready to Order | Level Design"
  description="The Studio Collection: the same design standard as our Signature Collection, at a more accessible price. A set of fixed sizes, made to order online."
  schema={schema}
>
  <div>

    <!-- Hero -->
    <section class="relative bg-gradient-to-r from-[#3d4f47] to-[#2d3f37] text-white pt-28 pb-12 md:pt-32 md:min-h-[24rem] flex items-center overflow-hidden">
      <div class="absolute inset-0 opacity-10">
        <div class="absolute top-0 right-0 w-96 h-96 bg-[#c8956a] rounded-full blur-3xl"></div>
      </div>
      <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl">
          <p class="hero-in text-[#c8956a] font-medium mb-4 tracking-wider uppercase text-sm" style="--delay: 0.2s">The Studio Collection</p>
          <h1 class="hero-in text-4xl sm:text-5xl md:text-6xl font-serif mb-6" style="--delay: 0.4s">Considered Design, Ready to Order</h1>
          <p class="hero-in text-lg sm:text-xl text-[#e8dcc8] mb-8" style="--delay: 0.6s">
            Four oak dining tables in fixed sizes — the same design standard as our Signature Collection, at a more accessible price.
          </p>
          <div class="hero-in flex flex-wrap gap-4" style="--delay: 0.8s">
            {["4 designs", `From ${formatPrice(startingPrice)}`, "6–8 week lead time"].map((item) => (
              <div class="px-4 py-2 bg-[#2d3f37] rounded-full text-sm flex items-center gap-2">
                <svg class="w-4 h-4 text-[#c8956a]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                {item}
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Tables Grid -->
    <section class="py-20 bg-[#f5f1e8]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          {allStudioProducts.map((table, i) => (
            <a
              href={`/studio/${table.id}/`}
              class="reveal group rounded-2xl overflow-hidden bg-white shadow-sm hover:shadow-xl transition-all duration-300"
              style={`--delay: ${(i % 4) * 0.1}s`}
            >
              <div class="aspect-[4/3] overflow-hidden">
                <img
                  src={table.images.gallery[0] ?? table.images.main}
                  alt={table.name}
                  loading="lazy"
                  width="1536"
                  height="1024"
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                />
              </div>
              <div class="p-6">
                <h3 class="text-xl font-semibold text-[#3d4f47] mb-1 group-hover:text-[#c8956a] transition-colors">{table.name}</h3>
                <p class="flex items-center gap-2 text-xs font-medium uppercase tracking-wide text-[#8a9b94] mb-2"><StudioShapeIcon product={table} /><span>{table.shape}</span></p>
                <p class="text-[#5a6b64] text-sm mb-3">{table.tagline}</p>
                <p class="font-semibold text-[#c8956a]">From {formatPrice(getStartingPrice(table))}</p>
              </div>
            </a>
          ))}
        </div>
        <div class="reveal max-w-4xl mt-14">
          <p class="text-[#5a6b64] text-lg leading-relaxed mb-5">
            Every table is built with real oak veneer over a stable substrate — made to last for years of daily use. The Line Table adds a fully solid oak base.
          </p>
          <p class="text-[#5a6b64] text-lg leading-relaxed">
            Looking for a fully bespoke commission instead? Explore the <a href="/signature/" class="text-[#c8956a] font-medium hover:underline">Signature Collection</a>, or start a <a href="/custom/" class="text-[#c8956a] font-medium hover:underline">custom design consultation</a>.
          </p>
        </div>
      </div>
    </section>

    <!-- Signature CTA -->
    <section class="py-20 bg-[#f5f1e8]">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <div class="reveal bg-gradient-to-r from-[#3d4f47] to-[#2d3f37] rounded-3xl p-12 text-white">
          <p class="text-sm uppercase tracking-wider text-[#c8956a] mb-4">Want It Made to Measure?</p>
          <h2 class="text-3xl md:text-4xl font-serif mb-4">Explore the Signature Collection</h2>
          <p class="text-[#e8dcc8] mb-8 max-w-2xl mx-auto">
            Fully bespoke designs, adapted to your space, seating requirements, and material preferences through a full design consultation.
          </p>
          <a href="/signature/" class="btn-scale inline-flex items-center gap-2 px-8 py-4 bg-[#c8956a] text-white rounded-full hover:bg-[#b8856a] transition-all duration-300 shadow-lg hover:shadow-xl">
            View the Signature Collection
          </a>
        </div>
      </div>
    </section>

    <section class="py-20 bg-white">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="reveal bg-[#f5f1e8] rounded-3xl p-8 md:p-10">
          <h2 class="text-3xl font-serif text-[#3d4f47] mb-8">Studio Collection FAQs</h2>
          <div class="space-y-6">
            {faqs.map((item) => (
              <div class="border-b border-[#d9cfbd] pb-6 last:border-b-0 last:pb-0">
                <h3 class="text-xl font-semibold text-[#3d4f47] mb-3">{item.question}</h3>
                <p class="text-[#5a6b64] leading-relaxed">{item.answer}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

  </div>
</Layout>
