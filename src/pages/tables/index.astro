---
import Layout from '../../layouts/Layout.astro';
import { allProducts } from '../../data/products';

const faqs = [
  {
    question: 'Can Level Design customise the size of any dining table?',
    answer:
      'Yes. Every Level Design table can be tailored to suit your room, seating needs, and preferred proportions, with guidance on dimensions before production starts.',
  },
  {
    question: 'Are these timber dining tables made in Melbourne?',
    answer:
      'Level Design tables are designed in Melbourne and made with a strong focus on Australian craftsmanship, with delivery available across Melbourne and wider Australia.',
  },
  {
    question: 'What timber and finish options are available?',
    answer:
      'Popular options include American Oak, Tasmanian Oak, American Ash, and custom finishes chosen to suit the look, durability, and daily use of your dining space.',
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};
---

<Layout
  title="Dining Tables Melbourne | Custom Timber Dining Tables | Level Design"
  description="Browse handcrafted timber dining tables in Melbourne by Level Design. Explore customisable solid timber dining table designs with tailored sizing, finish options, and Australia-wide delivery."
  schema={schema}
>
  <div class="pt-16">

    <!-- Hero -->
    <section class="relative bg-gradient-to-r from-[#3d4f47] to-[#2d3f37] text-white py-20 min-h-[30rem] flex items-center overflow-hidden">
      <div class="absolute inset-0 opacity-10">
        <div class="absolute top-0 right-0 w-96 h-96 bg-[#c8956a] rounded-full blur-3xl"></div>
      </div>
      <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl">
          <p class="hero-in text-[#c8956a] font-medium mb-4 tracking-wider uppercase text-sm" style="--delay: 0.2s">Signature Collection</p>
          <h1 class="hero-in text-5xl md:text-6xl font-serif mb-6" style="--delay: 0.4s">Find the Table That Fits Your Space</h1>
          <p class="hero-in text-xl text-[#e8dcc8] mb-8" style="--delay: 0.6s">
            Every design is handcrafted, proportioned for real homes, and finished to age beautifully.
          </p>
          <div class="hero-in flex flex-wrap gap-4" style="--delay: 0.8s">
            {["9 core designs", "Custom sizing available", "Sustainably sourced timber"].map((item) => (
              <div class="px-4 py-2 bg-[#2d3f37] rounded-full text-sm flex items-center gap-2">
                <svg class="w-4 h-4 text-[#c8956a]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                {item}
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Tables Grid -->
    <section class="py-20 bg-[#f5f1e8]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="reveal max-w-4xl mb-12">
          <p class="text-[#5a6b64] text-lg leading-relaxed mb-5">
            Level Design creates handcrafted timber dining tables for Melbourne homes, design-led renovations, and custom residential projects across Australia. Each design in this collection can be adapted to suit your layout, seating needs, and preferred material palette.
          </p>
          <p class="text-[#5a6b64] text-lg leading-relaxed">
            Whether you are searching for a round dining table for an apartment, a long rectangular table for open-plan living, or a statement pedestal design for entertaining, this collection is built to help you compare table styles before refining dimensions and finishes.
          </p>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {allProducts.map((table, i) => (
            <a
              href={`/tables/${table.id}/`}
              class="reveal group rounded-2xl overflow-hidden bg-white shadow-sm hover:shadow-xl transition-all duration-300"
              style={`--delay: ${(i % 3) * 0.1}s`}
            >
              <div class="aspect-[4/3] overflow-hidden">
                <img
                  src={table.images.main}
                  alt={table.name}
                  loading="lazy"
                  width="1536"
                  height="1024"
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                />
              </div>
              <div class="p-6">
                <h3 class="text-xl font-semibold text-[#3d4f47] mb-1 group-hover:text-[#c8956a] transition-colors">{table.name}</h3>
                <p class="text-[#5a6b64] text-sm">{table.tagline}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Custom CTA -->
    <section class="py-20 bg-[#f5f1e8]">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <div class="reveal bg-gradient-to-r from-[#3d4f47] to-[#2d3f37] rounded-3xl p-12 text-white">
          <p class="text-sm uppercase tracking-wider text-[#c8956a] mb-4">Need a Specific Size?</p>
          <h2 class="text-3xl md:text-4xl font-serif mb-4">We Can Tailor Any Design to Suit Your Room</h2>
          <p class="text-[#e8dcc8] mb-8 max-w-2xl mx-auto">
            Tell us your dimensions and preferred style, and we'll work with you to create the perfect table for your space.
          </p>
          <a href="/custom/" class="btn-scale inline-flex items-center gap-2 px-8 py-4 bg-[#c8956a] text-white rounded-full hover:bg-[#b8856a] transition-all duration-300 shadow-lg hover:shadow-xl">
            Explore Custom Tables
          </a>
        </div>
      </div>
    </section>

    <section class="py-20 bg-white">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="reveal text-center mb-14">
          <p class="text-[#c8956a] font-medium mb-4 tracking-wider uppercase text-sm">Choosing a Table</p>
          <h2 class="text-4xl md:text-5xl font-serif text-[#3d4f47] mb-6">How to Compare Timber Dining Tables</h2>
          <p class="text-xl text-[#5a6b64] max-w-3xl mx-auto">The best dining table is about more than style. Size, leg placement, seating comfort, material choice, and finish all affect how the piece works in daily life.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-14">
          {[
            {
              title: 'Start with room size',
              body: 'Leave enough circulation around the table so chairs can pull out comfortably and the room still feels generous when occupied.',
            },
            {
              title: 'Match the table to how you host',
              body: 'Round tables encourage conversation, while long rectangular tops tend to suit family dining, entertaining, and open-plan rooms.',
            },
            {
              title: 'Choose timber for both look and wear',
              body: 'Different species and finishes change the colour, grain character, maintenance needs, and how the table sits within the rest of your interior.',
            },
          ].map((item, i) => (
            <div class="reveal rounded-2xl bg-[#f5f1e8] p-8" style={`--delay: ${i * 0.1}s`}>
              <h3 class="text-2xl font-semibold text-[#3d4f47] mb-4">{item.title}</h3>
              <p class="text-[#5a6b64] leading-relaxed">{item.body}</p>
            </div>
          ))}
        </div>

        <div class="reveal bg-[#f5f1e8] rounded-3xl p-8 md:p-10">
          <h2 class="text-3xl font-serif text-[#3d4f47] mb-8">Dining Table FAQs</h2>
          <div class="space-y-6">
            {faqs.map((item) => (
              <div class="border-b border-[#d9cfbd] pb-6 last:border-b-0 last:pb-0">
                <h3 class="text-xl font-semibold text-[#3d4f47] mb-3">{item.question}</h3>
                <p class="text-[#5a6b64] leading-relaxed">{item.answer}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

  </div>
</Layout>
