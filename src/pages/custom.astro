---
import Layout from '../layouts/Layout.astro';
import CustomForm from '../components/CustomForm';
import { Image } from 'astro:assets';
import SectionHeader from '../components/SectionHeader.astro';
import IconFeatureGrid from '../components/IconFeatureGrid.astro';
import customImg from '../assets/images/custom/level-design-custom-furniture.webp';

const faqs = [
  {
    question: 'Can I customise the dimensions of my dining table?',
    answer:
      'Yes. Level Design custom dining tables are made to suit your room, circulation, seating requirements, and the way you use the space day to day.',
  },
  {
    question: 'What timber species and finishes can I choose from?',
    answer:
      'We can guide you through timber species such as American Oak, Tasmanian Oak, and other suitable options, then help narrow the finish based on colour, durability, and the look you want to achieve.',
  },
  {
    question: 'Do you work with Melbourne clients only?',
    answer:
      'Level Design is Melbourne-based, but projects can be discussed for other locations in Australia depending on delivery requirements and scope.',
  },
];

const serviceAreas = [
  'Melbourne',
  'Bayside',
  'Mornington Peninsula',
  'Geelong',
  'Regional Victoria by enquiry',
];

const processSteps = [
  { svg: '<path d="M21 6H3"/><path d="M10 12H3"/><path d="M10 18H3"/><circle cx="17" cy="15" r="3"/><path d="m21 18-1.9-1.9"/>', number: '01', title: 'Tailored Dimensions', desc: "Share your space measurements and seating needs. We'll recommend proportions that work." },
  { svg: '<circle cx="13.5" cy="6.5" r=".5" fill="currentColor"/><circle cx="17.5" cy="10.5" r=".5" fill="currentColor"/><circle cx="8.5" cy="7.5" r=".5" fill="currentColor"/><circle cx="6.5" cy="12.5" r=".5" fill="currentColor"/><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.555-2.503 5.555-5.554C21.965 6.012 17.461 2 12 2z"/>', number: '02', title: 'Timber & Finish Guidance', desc: 'Choose from sustainable timbers. We guide you through options for tone and durability.' },
  { svg: '<path d="M16.5 9.4 7.55 4.24"/><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.29 7 12 12 20.71 7"/><line x1="12" x2="12" y1="22" y2="12"/>', number: '03', title: 'Design and Refine', desc: 'Collaborate on the design until it feels right. We provide renders and material samples.' },
  { svg: '<path d="M5 17H3a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11a2 2 0 0 1 2 2v3"/><rect width="13" height="8" x="9" y="13" rx="1"/><path d="M16 13v-2a4 4 0 0 0-8 0v2"/><circle cx="11.5" cy="17.5" r=".5" fill="currentColor"/><circle cx="20.5" cy="17.5" r=".5" fill="currentColor"/>', number: '04', title: 'Craft and Deliver', desc: 'Your table is handcrafted by skilled makers, then delivered and installed with care.' },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Custom dining tables Melbourne',
  serviceType: 'Bespoke timber dining table design',
  provider: {
    '@type': 'LocalBusiness',
    name: 'Level Design',
    sameAs: 'https://share.google/2X8cmzgsefNsOyp1a',
  },
  areaServed: serviceAreas.map((area) => ({
    '@type': 'Place',
    name: area,
  })),
};
---

<Layout
  title="Custom Dining Tables Melbourne | Bespoke Timber Tables | Level Design"
  description="Design a custom dining table in Melbourne with Level Design. Bespoke timber dining tables tailored to your dimensions, timber preferences, finish, and everyday use."
  schema={[schema, serviceSchema]}
>
  <!-- Hidden form for Netlify detection -->
  <form name="custom-brief" data-netlify="true" data-netlify-honeypot="bot-field" style="display:none">
    <input name="name" /><input name="email" /><input name="phone" />
    <textarea name="projectDetails"></textarea>
    <input name="dimensions" /><input name="timberPreference" /><input name="budgetRange" /><input name="timeline" />
  </form>
  <div>

    <!-- Hero -->
    <section class="relative bg-gradient-to-r from-[#3d4f47] to-[#2d3f37] text-white pt-36 pb-20 min-h-[30rem] flex items-center overflow-hidden">
      <div class="absolute inset-0 opacity-10">
        <div class="absolute top-0 left-0 w-96 h-96 bg-[#c8956a] rounded-full blur-3xl"></div>
      </div>
      <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl">
          <p class="hero-in text-[#c8956a] font-medium mb-4 tracking-wider uppercase text-sm" style="--delay: 0.2s">Built for Your Space</p>
          <h1 class="hero-in text-5xl md:text-6xl font-serif mb-6" style="--delay: 0.4s">Custom Tables, Designed Around You</h1>
          <p class="hero-in text-xl text-[#e8dcc8] mb-8" style="--delay: 0.6s">
            From dimensions to materials, we collaborate with you to create a piece that feels intentional in your home.
          </p>
          <div class="hero-in flex flex-wrap gap-4" style="--delay: 0.8s">
            {["10 years of design & making", "Magazine-worthy results", "Built to last lifetimes"].map((item) => (
              <div class="px-4 py-2 bg-[#2d3f37] rounded-full text-sm flex items-center gap-2">
                <svg class="w-4 h-4 text-[#c8956a]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                {item}
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Custom Includes -->
    <section class="py-24 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          <div class="reveal-left relative">
            <div class="relative z-10 aspect-[4/5] rounded-2xl overflow-hidden shadow-2xl">
              <Image src={customImg} alt="Level Design custom furniture process" loading="lazy" class="w-full h-full object-cover" />
            </div>
            <div class="absolute -top-8 -left-8 w-32 h-32 bg-[#c8956a] rounded-2xl"></div>
            <div class="absolute -bottom-8 -right-8 w-32 h-32 bg-[#e8dcc8] rounded-2xl"></div>
          </div>
          <div class="reveal-right">
            <div class="bg-white rounded-2xl p-8 border border-[#e8dcc8]">
              <p class="text-[#c8956a] font-medium mb-4 tracking-wider uppercase text-sm">Custom Includes</p>
              <h2 class="text-3xl font-serif text-[#3d4f47] mb-6">What's Included in Your Custom Design</h2>
              <ul class="space-y-4">
                {[
                  "Tabletop shape and edge profile",
                  "Base style and leg geometry",
                  "Timber species and grain tone",
                  "Protective finish for daily use",
                ].map((item, i) => (
                  <li class="reveal flex items-start gap-3" style={`--delay: ${i * 0.1}s`}>
                    <svg class="text-[#c8956a] mt-1 flex-shrink-0 w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                    <span class="text-[#3d4f47]">{item}</span>
                  </li>
                ))}
              </ul>
              <div class="mt-8 pt-8 border-t border-[#e8dcc8]">
                <p class="text-sm text-[#5a6b64] mb-4">Every custom table starts with understanding your space and how you'll use it.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="py-24 bg-[#f5f1e8]">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <SectionHeader
          eyebrow="Custom Table Design"
          title="Bespoke Timber Dining Tables for Melbourne Homes"
          description="Our custom process is designed for people who want a table that feels resolved in both scale and detail, whether that means fitting a tighter dining zone or creating a centrepiece for entertaining."
          wrapperClass="text-center mb-14"
          descriptionClass="text-xl text-[#5a6b64] max-w-3xl mx-auto"
        >
          <a href="/melbourne-custom-dining-tables/" class="inline-flex mt-6 text-[#c8956a] font-medium hover:underline">
            Learn about custom dining tables in Melbourne →
          </a>
        </SectionHeader>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          {[
            {
              title: 'Designed around your layout',
              body: 'We help determine practical dimensions, ideal overhangs, leg placement, and seating counts so the finished table feels natural in the room rather than simply filling it.',
            },
            {
              title: 'Material decisions made with guidance',
              body: 'Timber species, finish level, edge profile, and base style all affect the final character of the piece. We work through those decisions with you before production begins.',
            },
            {
              title: 'Suitable for architects and interior designers',
              body: 'If you are specifying furniture for a project, we can help align the table with the wider interior palette, circulation plan, and client brief.',
            },
            {
              title: 'Built for everyday durability',
              body: 'Every custom table balances appearance with daily practicality, so the final finish and detailing support real family life, entertaining, and long-term use.',
            },
          ].map((item, i) => (
            <div class="reveal rounded-2xl bg-white p-8 shadow-sm" style={`--delay: ${i * 0.1}s`}>
              <h3 class="text-2xl font-semibold text-[#3d4f47] mb-4">{item.title}</h3>
              <p class="text-[#5a6b64] leading-relaxed">{item.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="py-20 bg-white">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="reveal rounded-3xl bg-[#f5f1e8] p-8 md:p-10">
          <div class="grid grid-cols-1 lg:grid-cols-[1.2fr_0.8fr] gap-10 items-start">
            <div>
              <p class="text-[#c8956a] font-medium mb-4 tracking-wider uppercase text-sm">Melbourne Service Area</p>
              <h2 class="text-3xl md:text-4xl font-serif text-[#3d4f47] mb-5">Custom Tables for Melbourne and Victorian Homes</h2>
              <p class="text-[#5a6b64] text-lg leading-relaxed">
                Most custom projects begin with a Melbourne or Victorian home, renovation, or interior design brief. We can help resolve table size, timber tone, finish, and delivery considerations early, so the finished piece feels right in the room.
              </p>
            </div>
            <div class="grid grid-cols-1 gap-3">
              {serviceAreas.map((area) => (
                <div class="rounded-xl bg-white px-4 py-3 text-[#3d4f47] font-medium shadow-sm">{area}</div>
              ))}
            </div>
          </div>
          <a href="/contact/" class="inline-flex mt-8 text-[#c8956a] font-medium hover:underline">
            Ask about your Melbourne table project →
          </a>
        </div>
      </div>
    </section>

    <!-- Process -->
    <section class="py-24 bg-[#f5f1e8]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <SectionHeader
          eyebrow="Our Process"
          title="Clear Steps, No Guesswork"
          description="From initial concept to final delivery, we guide you through every step with clarity and care."
        />
        <IconFeatureGrid
          items={processSteps}
          gridClass="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8"
          titleClass="text-xl font-semibold text-[#3d4f47] mb-3"
        />
      </div>
    </section>

    <!-- 3D Design Showcase -->
    <section id="model-section" class="py-24 bg-[#2d3f37] text-white overflow-hidden">
      <script is:inline>
        (function() {
          var loaded = false;
          var observer = new IntersectionObserver(function(entries) {
            if (entries[0].isIntersecting && !loaded) {
              loaded = true;
              var s = document.createElement('script');
              s.type = 'module';
              s.src = 'https://ajax.googleapis.com/ajax/libs/model-viewer/3.5.0/model-viewer.min.js';
              document.head.appendChild(s);
              observer.disconnect();
            }
          }, { rootMargin: '200px' });
          var el = document.getElementById('model-section');
          if (el) observer.observe(el);
        })();
      </script>

      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">

          <!-- 3D Model viewer -->
          <div class="reveal-left order-2 lg:order-1">
            <div class="relative rounded-2xl overflow-hidden" style="background: #3d4f47;">
              <model-viewer
                src="/models/pillar-table-model-v2.glb"
                auto-rotate
                auto-rotate-delay="0"
                rotation-per-second="20deg"
                camera-controls
                shadow-intensity="1.2"
                shadow-softness="0.8"
                exposure="1.1"
                style="width:100%; height:480px; background:transparent; --progress-bar-color: transparent; --progress-bar-height: 0px;"
                loading="lazy"
              >
                <div slot="poster" style="display:flex; align-items:center; justify-content:center; width:100%; height:100%; background:#3d4f47;">
                  <div style="display:flex; flex-direction:column; align-items:center; gap:16px;">
                    <svg style="width:40px; height:40px; animation:model-spin 1s linear infinite;" viewBox="0 0 24 24" fill="none">
                      <circle cx="12" cy="12" r="10" stroke="#c8956a" stroke-width="2" stroke-opacity="0.3"/>
                      <path d="M12 2a10 10 0 0 1 10 10" stroke="#c8956a" stroke-width="2" stroke-linecap="round"/>
                    </svg>
                    <span style="color:#e8dcc8; font-size:13px; letter-spacing:0.1em; opacity:0.7;">Loading model...</span>
                  </div>
                </div>
              </model-viewer>
              <style>@keyframes model-spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }</style>
              <div class="absolute bottom-4 left-0 right-0 flex justify-center pointer-events-none">
                <span class="bg-black/30 text-white/60 text-xs tracking-widest px-4 py-1.5 rounded-full">Drag to rotate · Scroll to zoom</span>
              </div>
            </div>
          </div>

          <!-- Content -->
          <div class="reveal-right order-1 lg:order-2">
            <p class="text-[#c8956a] font-medium mb-4 tracking-wider uppercase text-sm">Design & Craft</p>
            <h2 class="text-4xl md:text-5xl font-serif mb-6">Every Table Starts as an Idea</h2>
            <p class="text-[#e8dcc8] text-lg mb-5 leading-relaxed">Before a single piece of timber is cut, each table goes through a rigorous design phase. We think carefully about proportion, structural integrity, and how the piece will feel in real daily use.</p>
            <p class="text-[#a0b8b0] text-base mb-10 leading-relaxed">3D modelling lets us resolve every joint, leg profile, and edge detail before the workshop — so what gets built is exactly what was envisioned.</p>

            <div class="space-y-6">
              {[
                { title: "Proportioned to your space", desc: "Table dimensions are modelled against your room before anything is made — no guesswork." },
                { title: "Structural integrity by design", desc: "Every joint, base configuration, and leg angle is considered for long-term strength and stability." },
                { title: "Material decisions resolved early", desc: "Timber grain direction, edge profiles, and finishes are locked in at the design stage, not on the workshop floor." },
              ].map((item) => (
                <div class="flex items-start gap-4">
                  <div class="w-8 h-8 rounded-lg bg-[#c8956a]/20 flex items-center justify-center flex-shrink-0 mt-0.5">
                    <svg class="w-4 h-4 text-[#c8956a]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                      <path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>
                    </svg>
                  </div>
                  <div>
                    <div class="font-semibold text-white mb-1">{item.title}</div>
                    <div class="text-[#a0b8b0] text-sm leading-relaxed">{item.desc}</div>
                  </div>
                </div>
              ))}
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- Form + FAQ (React island) -->
    <CustomForm client:visible />

    <section class="py-24 bg-white">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="reveal bg-[#f5f1e8] rounded-3xl p-8 md:p-10">
          <h2 class="text-3xl md:text-4xl font-serif text-[#3d4f47] mb-8">Custom Dining Table FAQs</h2>
          <div class="space-y-6">
            {faqs.map((item) => (
              <div class="border-b border-[#d9cfbd] pb-6 last:border-b-0 last:pb-0">
                <h3 class="text-xl font-semibold text-[#3d4f47] mb-3">{item.question}</h3>
                <p class="text-[#5a6b64] leading-relaxed">{item.answer}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

  </div>
</Layout>
