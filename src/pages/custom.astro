---
import Layout from '../layouts/Layout.astro';
import CustomForm from '../components/CustomForm';
import { Image } from 'astro:assets';
import SectionHeader from '../components/SectionHeader.astro';
import ModelViewer from '../components/ModelViewer.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import customImg from '../assets/images/custom/level-design-custom-furniture.webp';
import { products } from '../data/signature-products';
import { allStudioProducts, startingPrice } from '../data/studio-products';

const studioFrom = new Intl.NumberFormat('en-AU', { style: 'currency', currency: 'AUD', maximumFractionDigits: 0 }).format(
  Math.min(...allStudioProducts.map(startingPrice)) / 100,
);

const faqs = [
  {
    question: 'What does the design consultation involve?',
    answer:
      'The consultation is a conversation about your space, your lifestyle, and what you need the table to do. We discuss room dimensions, seating requirements, how you entertain, and your material preferences — and from there we develop a design that feels resolved for your specific situation.',
  },
  {
    question: 'How long does a custom table take?',
    answer:
      'The design and consultation phase typically takes one to two weeks, depending on how quickly decisions are made and whether refinements are needed. Once the design is approved, production and delivery typically take 8–12 weeks, depending on timber availability and complexity. We\'ll give you a clear timeline from the outset.',
  },
  {
    question: 'How much does a custom table cost?',
    answer:
      `Custom tables typically start from $5,000. The final price depends on the size, timber, design and finish, and we'll give you a clear figure once the design is resolved. If you'd like something ready to order, the Studio Collection starts from ${studioFrom}.`,
  },
  {
    question: 'What timber species and finishes are available?',
    answer:
      'We work primarily with American Oak, Tasmanian Oak, and American Ash, and can also work with American Walnut and Australian timbers including Blackbutt, Spotted Gum, and Victorian Ash — all sustainably sourced. Finish options include raw matte, clear matte, black satin, and black wash — each selected in the context of your interior palette and how the table will be used. We guide you through every option.',
  },
  {
    question: 'Do you work with interior designers and architects?',
    answer:
      'Yes. We work directly with designers and architects on residential projects, providing close specification support, timber guidance, and flexible dimensions to suit their clients\' briefs and interior palettes.',
  },
  {
    question: 'Can you match existing furniture?',
    answer:
      'Yes. Bring photos or samples and we\'ll work to complement your existing pieces in tone and style.',
  },
  {
    question: 'Does the table arrive assembled?',
    answer:
      'Each table is made in two parts, the top and the base, and arrives that way. Delivery includes assembly, so we put your table together in your room and there is nothing for you to build. We\'ll check access, such as stairs, lifts, doorways and parking, when we arrange your delivery date.',
  },
  {
    question: 'Do you deliver outside Melbourne?',
    answer:
      'We deliver Melbourne-wide. For anywhere else in Australia, reach out and we\'ll work out the details with you.',
  },
];

const serviceAreas = [
  'Melbourne',
  'Bayside',
  'Mornington Peninsula',
  'Bass Coast and Phillip Island',
  'Geelong',
  'Regional Victoria by enquiry',
];

const processSteps = [
  {
    number: '01',
    title: 'Consultation',
    desc: "We begin by understanding your space, lifestyle, seating needs, and how you entertain. This conversation shapes everything that follows.",
    points: [
      'Your space: room dimensions, floor plan, and circulation',
      'How you live: family dining, entertaining, everyday use',
      'Scale and proportion: the right dimensions for your room',
      'Seating requirements: daily use and larger gatherings',
    ],
  },
  { number: '02', title: 'Design Development', desc: 'We work through proportion, silhouette, base design, and edge detail — refining until the table feels right for your room.' },
  { number: '03', title: 'Material Selection', desc: 'Timber species, finish tone, and edge profile are chosen together in the context of your interior — guided by both aesthetics and daily use.' },
  { number: '04', title: 'Production', desc: 'Once every decision is resolved, your table is made by hand using traditional joinery and sustainably sourced American and Australian hardwoods.' },
  { number: '05', title: 'Delivery', desc: 'We deliver your table in two parts, the top and the base, and assemble it in your room, then share aftercare guidance so it keeps looking its best.' },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Custom dining tables Melbourne',
  serviceType: 'Bespoke timber dining table design',
  provider: {
    '@type': 'LocalBusiness',
    name: 'Level Design',
    sameAs: 'https://share.google/2X8cmzgsefNsOyp1a',
  },
  areaServed: serviceAreas.map((area) => ({
    '@type': 'Place',
    name: area,
  })),
};
---

<Layout
  title="Custom Dining Tables | Design Consultation | Level Design"
  description="Book a bespoke dining table design consultation in Melbourne. Custom tables shaped around your space, seating, timber and finish."
  schema={[schema, serviceSchema]}
>
  <!-- Hidden form for Netlify detection -->
  <form name="custom-brief" data-netlify="true" data-netlify-honeypot="bot-field" style="display:none">
    <input name="name" /><input name="email" /><input name="phone" />
    <textarea name="projectDetails"></textarea>
    <input name="dimensions" /><input name="timberPreference" /><input name="budgetRange" /><input name="timeline" />
  </form>
  <div>

    <!-- Hero -->
    <section class="relative bg-gradient-to-r from-[#3d4f47] to-[#2d3f37] text-white pt-28 pb-12 md:pt-32 md:min-h-[24rem] flex items-center overflow-hidden">
      <div class="absolute inset-0 opacity-10">
        <div class="absolute top-0 left-0 w-96 h-96 bg-[#c8956a] rounded-full blur-3xl"></div>
      </div>
      <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl">
          <p class="hero-in text-[#c8956a] font-medium mb-4 tracking-wider uppercase text-sm" style="--delay: 0.2s">Custom Dining Table Design — Melbourne</p>
          <h1 class="hero-in text-4xl sm:text-5xl md:text-6xl font-serif mb-6" style="--delay: 0.4s">Designed Around Your Space and the Way You Live</h1>
          <p class="hero-in text-lg sm:text-xl text-[#e8dcc8] mb-8" style="--delay: 0.6s">
            Every project begins with understanding how you use your home — how many people you seat, how you entertain, and what the table needs to do. The design follows from there.
          </p>
          <div class="hero-in flex flex-wrap gap-4" style="--delay: 0.8s">
            {["Custom tables from $5,000", "10+ years of design expertise", "Made in Melbourne"].map((item) => (
              <div class="px-4 py-2 bg-[#2d3f37] rounded-full text-sm flex items-center gap-2">
                <svg class="w-4 h-4 text-[#c8956a]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                {item}
              </div>
            ))}
          </div>
          <div class="hero-in mt-8" style="--delay: 1s">
            <a href="#brief" class="btn-scale inline-flex items-center gap-2 px-8 py-4 bg-[#c8956a] text-white rounded-full hover:bg-[#b8856a] transition-all duration-300 shadow-lg hover:shadow-xl">
              Start your brief →
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Signature tables (the Projects page covers Pillar, Venn and Luna) -->
    <section class="py-16 md:py-20 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="reveal flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-8">
          <div>
            <p class="text-[#c8956a] font-medium mb-3 tracking-wider uppercase text-sm">Our Work</p>
            <h2 class="text-3xl md:text-4xl font-serif text-[#3d4f47]">Made for Real Rooms</h2>
          </div>
          <a href="/signature/" class="text-[#c8956a] font-medium hover:underline">See the Signature Collection →</a>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          {[products.morgan, products.cort, products.helm].map((table, i) => (
            <a href={`/signature/${table.id}/`} class="reveal group block" style={`--delay: ${i * 0.1}s`}>
              <div class="aspect-[4/3] rounded-2xl overflow-hidden">
                <img src={table.images.main} alt={table.name} loading="lazy" width="1536" height="1024" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
              </div>
              <p class="mt-3 font-semibold text-[#3d4f47]">{table.name}</p>
              <p class="text-sm text-[#5a6b64]">{table.tagline}</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Process -->
    <section class="py-16 md:py-24 bg-[#f5f1e8]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <SectionHeader
          eyebrow="The Design Process"
          title="From Consultation to Delivery"
          description="Design and collaboration come first. Production follows only once every decision has been resolved — so the table you receive is the table you imagined."
        />
        <div class="mt-10 grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.3fr)] gap-10 lg:gap-16 items-start">
          <div class="reveal-left lg:sticky lg:top-28">
            <div class="aspect-[4/5] max-w-md mx-auto lg:max-w-none rounded-2xl overflow-hidden">
              <Image src={customImg} alt="A custom table top and bases being made at Level Design" loading="lazy" class="w-full h-full object-cover" />
            </div>
          </div>
          <ol class="space-y-8">
            {processSteps.map((step, i) => (
              <li class="reveal flex gap-5" style={`--delay: ${i * 0.08}s`}>
                <span class="flex-shrink-0 w-10 h-10 rounded-full bg-[#3d4f47] text-white text-sm font-medium flex items-center justify-center">{step.number}</span>
                <div>
                  <h3 class="text-lg font-semibold text-[#3d4f47] mb-1">{step.title}</h3>
                  <p class="text-[#5a6b64] leading-relaxed">{step.desc}</p>
                  {step.points && (
                    <ul class="mt-3 space-y-2">
                      {step.points.map((point) => (
                        <li class="flex items-start gap-3 text-[#3d4f47] text-sm">
                          <svg class="text-[#c8956a] mt-0.5 flex-shrink-0 w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                          <span>{point}</span>
                        </li>
                      ))}
                    </ul>
                  )}
                </div>
              </li>
            ))}
          </ol>
        </div>
        <div class="mt-12 text-center">
          <a href="#brief" class="btn-scale inline-flex items-center gap-2 px-8 py-4 bg-[#3d4f47] text-white rounded-full hover:bg-[#2d3f37] transition-all duration-300 shadow-lg hover:shadow-xl">
            Start your brief →
          </a>
          <p class="mt-6 text-sm text-[#5a6b64]">
            We work across Melbourne, the Bass Coast, the Mornington Peninsula, Geelong and regional Victoria. <a href="/melbourne-custom-dining-tables/" class="text-[#c8956a] font-medium hover:underline">More about our Melbourne work →</a>
          </p>
        </div>
      </div>
    </section>

    <!-- 3D Design Showcase -->
    <section id="model-section" class="py-16 md:py-24 bg-[#2d3f37] text-white overflow-hidden">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">

          <!-- 3D Model viewer -->
          <div class="reveal-left order-2 lg:order-1">
            <ModelViewer src="/models/signature/pillar-table-model-v2.glb" />
          </div>

          <!-- Content -->
          <div class="reveal-right order-1 lg:order-2">
            <p class="text-[#c8956a] font-medium mb-4 tracking-wider uppercase text-sm">Design Development</p>
            <h2 class="text-4xl md:text-5xl font-serif mb-6">Resolved in Design Before a Single Cut Is Made</h2>
            <p class="text-[#e8dcc8] text-lg mb-5 leading-relaxed">Every table is fully developed through a design phase before production begins. We think carefully about proportion, structural integrity, and how the piece will feel in the room it's made for.</p>
            <p class="text-[#a0b8b0] text-base mb-10 leading-relaxed">3D modelling allows us to resolve every detail — joint, leg profile, edge, and finish — so what gets built is exactly what was designed. No surprises.</p>

            <div class="space-y-6">
              {[
                { title: "Proportioned to your space", desc: "Table dimensions are modelled against your room before anything is made — no guesswork." },
                { title: "Structural integrity by design", desc: "Every joint, base configuration, and leg angle is considered for long-term strength and stability." },
                { title: "Material decisions resolved early", desc: "Timber grain direction, edge profiles, and finishes are locked in at the design stage, not on the workshop floor." },
              ].map((item) => (
                <div class="flex items-start gap-4">
                  <div class="w-8 h-8 rounded-lg bg-[#c8956a]/20 flex items-center justify-center flex-shrink-0 mt-0.5">
                    <svg class="w-4 h-4 text-[#c8956a]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                      <path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>
                    </svg>
                  </div>
                  <div>
                    <div class="font-semibold text-white mb-1">{item.title}</div>
                    <div class="text-[#a0b8b0] text-sm leading-relaxed">{item.desc}</div>
                  </div>
                </div>
              ))}
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- Form + FAQ (React island) -->
    <CustomForm client:visible />

    <!-- Studio shortcut -->
    <section class="pt-0 pb-10 bg-white">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="reveal flex flex-col sm:flex-row items-center justify-between gap-4 bg-[#f5f1e8] rounded-2xl p-6 md:p-8">
          <div>
            <p class="text-[#c8956a] font-medium text-sm mb-1">Want something ready to order?</p>
            <p class="text-[#3d4f47]">The Studio Collection offers the same design standard at a more accessible price, from {studioFrom} — order online today.</p>
          </div>
          <a href="/studio/" class="flex-shrink-0 inline-flex items-center gap-2 px-6 py-3 bg-[#3d4f47] text-white rounded-full hover:bg-[#2d3f37] transition-all duration-300 whitespace-nowrap">
            Shop the Studio Collection →
          </a>
        </div>
      </div>
    </section>

    <section class="pt-0 pb-16 md:pb-24 bg-white">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="reveal bg-[#f5f1e8] rounded-3xl p-6 md:p-10">
          <h2 class="text-3xl md:text-4xl font-serif text-[#3d4f47] mb-8">Custom Dining Table FAQs</h2>
          <FaqAccordion items={faqs} />
        </div>
      </div>
    </section>

  </div>
</Layout>
