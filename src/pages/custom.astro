---
import Layout from '../layouts/Layout.astro';
import CustomForm from '../components/CustomForm';
import { Image } from 'astro:assets';
import SectionHeader from '../components/SectionHeader.astro';
import IconFeatureGrid from '../components/IconFeatureGrid.astro';
import ModelViewer from '../components/ModelViewer.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import customImg from '../assets/images/custom/level-design-custom-furniture.webp';

const faqs = [
  {
    question: 'What does the design consultation involve?',
    answer:
      'The consultation is a conversation about your space, your lifestyle, and what you need the table to do. We discuss room dimensions, seating requirements, how you entertain, and your material preferences — and from there we develop a design that feels resolved for your specific situation.',
  },
  {
    question: 'How long does the custom design process take?',
    answer:
      'The design and consultation phase typically takes one to two weeks, depending on how quickly decisions are made and whether refinements are needed. Production follows once the design is finalised. We\'ll give you a clear timeline from the outset.',
  },
  {
    question: 'What timber species and finishes are available?',
    answer:
      'We work primarily with American Oak, Tasmanian Oak, and American Ash. Finish options include raw matte, clear matte, black satin, and black wash — each selected in the context of your interior palette and how the table will be used. We guide you through every option.',
  },
  {
    question: 'Do you work with interior designers and architects?',
    answer:
      'Yes. We work directly with designers and architects on residential projects, providing close specification support, timber guidance, and flexible dimensions to suit their clients\' briefs and interior palettes.',
  },
];

const serviceAreas = [
  'Melbourne',
  'Bayside',
  'Mornington Peninsula',
  'Geelong',
  'Regional Victoria by enquiry',
];

const processSteps = [
  { svg: '<path d="M21 6H3"/><path d="M10 12H3"/><path d="M10 18H3"/><circle cx="17" cy="15" r="3"/><path d="m21 18-1.9-1.9"/>', number: '01', title: 'Consultation', desc: "We begin by understanding your space, lifestyle, seating needs, and how you entertain. This conversation shapes everything that follows." },
  { svg: '<path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/>', number: '02', title: 'Design Development', desc: 'We work through proportion, silhouette, base design, and edge detail — refining until the table feels right for your room.' },
  { svg: '<circle cx="13.5" cy="6.5" r=".5" fill="currentColor"/><circle cx="17.5" cy="10.5" r=".5" fill="currentColor"/><circle cx="8.5" cy="7.5" r=".5" fill="currentColor"/><circle cx="6.5" cy="12.5" r=".5" fill="currentColor"/><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.555-2.503 5.555-5.554C21.965 6.012 17.461 2 12 2z"/>', number: '03', title: 'Material Selection', desc: 'Timber species, finish tone, and edge profile are chosen together in the context of your interior — guided by both aesthetics and daily use.' },
  { svg: '<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>', number: '04', title: 'Production', desc: 'Once every decision is resolved, your table is made by hand using traditional joinery and sustainably sourced American and Australian hardwoods.' },
  { svg: '<path d="M5 17H3a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11a2 2 0 0 1 2 2v3"/><rect width="13" height="8" x="9" y="13" rx="1"/><path d="M16 13v-2a4 4 0 0 0-8 0v2"/>', number: '05', title: 'Delivery', desc: 'We coordinate delivery and provide aftercare guidance so your table continues to look and live its best for generations.' },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Custom dining tables Melbourne',
  serviceType: 'Bespoke timber dining table design',
  provider: {
    '@type': 'LocalBusiness',
    name: 'Level Design',
    sameAs: 'https://share.google/2X8cmzgsefNsOyp1a',
  },
  areaServed: serviceAreas.map((area) => ({
    '@type': 'Place',
    name: area,
  })),
};
---

<Layout
  title="Custom Dining Table Design Melbourne | Design Consultation | Level Design"
  description="Level Design offers a bespoke dining table design consultation in Melbourne. We design custom dining tables around your space, lifestyle, seating requirements, and material preferences."
  schema={[schema, serviceSchema]}
>
  <!-- Hidden form for Netlify detection -->
  <form name="custom-brief" data-netlify="true" data-netlify-honeypot="bot-field" style="display:none">
    <input name="name" /><input name="email" /><input name="phone" />
    <textarea name="projectDetails"></textarea>
    <input name="dimensions" /><input name="timberPreference" /><input name="budgetRange" /><input name="timeline" />
  </form>
  <div>

    <!-- Hero -->
    <section class="relative bg-gradient-to-r from-[#3d4f47] to-[#2d3f37] text-white pt-36 pb-20 min-h-[30rem] flex items-center overflow-hidden">
      <div class="absolute inset-0 opacity-10">
        <div class="absolute top-0 left-0 w-96 h-96 bg-[#c8956a] rounded-full blur-3xl"></div>
      </div>
      <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl">
          <p class="hero-in text-[#c8956a] font-medium mb-4 tracking-wider uppercase text-sm" style="--delay: 0.2s">Custom Dining Table Design — Melbourne</p>
          <h1 class="hero-in text-5xl md:text-6xl font-serif mb-6" style="--delay: 0.4s">Designed Around Your Space and the Way You Live</h1>
          <p class="hero-in text-xl text-[#e8dcc8] mb-8" style="--delay: 0.6s">
            Every project begins with understanding how you use your home — how many people you seat, how you entertain, and what the table needs to do. The design follows from there.
          </p>
          <div class="hero-in flex flex-wrap gap-4" style="--delay: 0.8s">
            {["10+ years of design expertise", "Heirloom-quality pieces", "Design-led from the first conversation"].map((item) => (
              <div class="px-4 py-2 bg-[#2d3f37] rounded-full text-sm flex items-center gap-2">
                <svg class="w-4 h-4 text-[#c8956a]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                {item}
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Custom Includes -->
    <section class="py-24 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          <div class="reveal-left relative">
            <div class="relative z-10 aspect-[4/5] rounded-2xl overflow-hidden shadow-2xl">
              <Image src={customImg} alt="Level Design custom furniture process" loading="lazy" class="w-full h-full object-cover" />
            </div>
            <div class="absolute -top-8 -left-8 w-32 h-32 bg-[#c8956a] rounded-2xl"></div>
            <div class="absolute -bottom-8 -right-8 w-32 h-32 bg-[#e8dcc8] rounded-2xl"></div>
          </div>
          <div class="reveal-right">
            <div class="bg-white rounded-2xl p-8 border border-[#e8dcc8]">
              <p class="text-[#c8956a] font-medium mb-4 tracking-wider uppercase text-sm">What the Consultation Covers</p>
              <h2 class="text-3xl font-serif text-[#3d4f47] mb-6">A Design Process Built Around You</h2>
              <ul class="space-y-4">
                {[
                  "Your space — room dimensions, floor plan, and circulation",
                  "How you live — family dining, entertaining, everyday use",
                  "Scale and proportion — the right dimensions for your room",
                  "Seating requirements — daily use and larger gatherings",
                  "Material selection — timber species, finish, and edge profile",
                  "Design refinement — before a single piece of timber is cut",
                ].map((item, i) => (
                  <li class="reveal flex items-start gap-3" style={`--delay: ${i * 0.1}s`}>
                    <svg class="text-[#c8956a] mt-1 flex-shrink-0 w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                    <span class="text-[#3d4f47]">{item}</span>
                  </li>
                ))}
              </ul>
              <div class="mt-8 pt-8 border-t border-[#e8dcc8]">
                <p class="text-sm text-[#5a6b64] mb-4">Production begins only once the design feels resolved and right for your room.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="py-24 bg-[#f5f1e8]">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <SectionHeader
          eyebrow="The Design Consultation"
          title="Bespoke Dining Tables Designed for Your Space"
          description="Our approach puts design at the centre. We begin by understanding how you live, how you entertain, and what role the dining table plays in your home — then we design around that."
          wrapperClass="text-center mb-14"
          descriptionClass="text-xl text-[#5a6b64] max-w-3xl mx-auto"
        >
          <a href="/melbourne-custom-dining-tables/" class="inline-flex mt-6 text-[#c8956a] font-medium hover:underline">
            Learn about custom dining tables in Melbourne →
          </a>
        </SectionHeader>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          {[
            {
              title: 'Understanding your space',
              body: 'Before any design decisions are made, we look carefully at how your room is proportioned — ceiling height, floor area, natural light, and circulation — to ensure the table works spatially as well as aesthetically.',
            },
            {
              title: 'Designing for family living and entertaining',
              body: 'We ask how you actually use your dining space. A household that entertains regularly has different needs to one that primarily wants a table for family dinners — and the design should reflect that.',
            },
            {
              title: 'Material selection as a design decision',
              body: 'Timber species, finish, and edge profile are not afterthoughts. They are integral to how the piece feels in the room. We guide you through the options in the context of your interior and daily use.',
            },
            {
              title: 'Designed for designers and architects',
              body: 'We work directly with interior designers and architects on residential projects, helping align the table design with the wider brief, material palette, and client requirements.',
            },
          ].map((item, i) => (
            <div class="reveal rounded-2xl bg-white p-8 shadow-sm" style={`--delay: ${i * 0.1}s`}>
              <h3 class="text-2xl font-semibold text-[#3d4f47] mb-4">{item.title}</h3>
              <p class="text-[#5a6b64] leading-relaxed">{item.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="py-20 bg-white">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="reveal rounded-3xl bg-[#f5f1e8] p-8 md:p-10">
          <div class="grid grid-cols-1 lg:grid-cols-[1.2fr_0.8fr] gap-10 items-start">
            <div>
              <p class="text-[#c8956a] font-medium mb-4 tracking-wider uppercase text-sm">Melbourne Service Area</p>
              <h2 class="text-3xl md:text-4xl font-serif text-[#3d4f47] mb-5">Custom Tables for Melbourne and Victorian Homes</h2>
              <p class="text-[#5a6b64] text-lg leading-relaxed">
                Most custom projects begin with a Melbourne or Victorian home, renovation, or interior design brief. We can help resolve table size, timber tone, finish, and delivery considerations early, so the finished piece feels right in the room.
              </p>
            </div>
            <div class="grid grid-cols-1 gap-3">
              {serviceAreas.map((area) => (
                <div class="rounded-xl bg-white px-4 py-3 text-[#3d4f47] font-medium shadow-sm">{area}</div>
              ))}
            </div>
          </div>
          <a href="/contact/" class="inline-flex mt-8 text-[#c8956a] font-medium hover:underline">
            Ask about your Melbourne table project →
          </a>
        </div>
      </div>
    </section>

    <!-- Process -->
    <section class="py-24 bg-[#f5f1e8]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <SectionHeader
          eyebrow="The Design Process"
          title="From Consultation to Delivery"
          description="Design and collaboration come first. Production follows only once every decision has been resolved — so the table you receive is the table you imagined."
        />
        <IconFeatureGrid
          items={processSteps}
          gridClass="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-5 gap-8"
          titleClass="text-xl font-semibold text-[#3d4f47] mb-3"
        />
      </div>
    </section>

    <!-- 3D Design Showcase -->
    <section id="model-section" class="py-24 bg-[#2d3f37] text-white overflow-hidden">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">

          <!-- 3D Model viewer -->
          <div class="reveal-left order-2 lg:order-1">
            <ModelViewer src="/models/signature/pillar-table-model-v2.glb" />
          </div>

          <!-- Content -->
          <div class="reveal-right order-1 lg:order-2">
            <p class="text-[#c8956a] font-medium mb-4 tracking-wider uppercase text-sm">Design Development</p>
            <h2 class="text-4xl md:text-5xl font-serif mb-6">Resolved in Design Before a Single Cut Is Made</h2>
            <p class="text-[#e8dcc8] text-lg mb-5 leading-relaxed">Every table is fully developed through a design phase before production begins. We think carefully about proportion, structural integrity, and how the piece will feel in the room it's made for.</p>
            <p class="text-[#a0b8b0] text-base mb-10 leading-relaxed">3D modelling allows us to resolve every detail — joint, leg profile, edge, and finish — so what gets built is exactly what was designed. No surprises.</p>

            <div class="space-y-6">
              {[
                { title: "Proportioned to your space", desc: "Table dimensions are modelled against your room before anything is made — no guesswork." },
                { title: "Structural integrity by design", desc: "Every joint, base configuration, and leg angle is considered for long-term strength and stability." },
                { title: "Material decisions resolved early", desc: "Timber grain direction, edge profiles, and finishes are locked in at the design stage, not on the workshop floor." },
              ].map((item) => (
                <div class="flex items-start gap-4">
                  <div class="w-8 h-8 rounded-lg bg-[#c8956a]/20 flex items-center justify-center flex-shrink-0 mt-0.5">
                    <svg class="w-4 h-4 text-[#c8956a]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                      <path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>
                    </svg>
                  </div>
                  <div>
                    <div class="font-semibold text-white mb-1">{item.title}</div>
                    <div class="text-[#a0b8b0] text-sm leading-relaxed">{item.desc}</div>
                  </div>
                </div>
              ))}
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- Form + FAQ (React island) -->
    <CustomForm client:visible />

    <section class="py-24 bg-white">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="reveal bg-[#f5f1e8] rounded-3xl p-8 md:p-10">
          <h2 class="text-3xl md:text-4xl font-serif text-[#3d4f47] mb-8">Custom Dining Table FAQs</h2>
          <FaqAccordion items={faqs} />
        </div>
      </div>
    </section>

  </div>
</Layout>
