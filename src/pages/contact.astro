---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm';
import { Image } from 'astro:assets';
import SectionHeader from '../components/SectionHeader.astro';
import contactImg from '../assets/images/contact/level-design-contact-image.webp';

const serviceAreas = [
  {
    area: 'Melbourne',
    detail: 'Custom timber dining tables for homes, renovations, and design-led residential projects across inner and middle Melbourne, including Toorak, South Yarra, Armadale, Malvern, Kew, Hawthorn, Fitzroy, Northcote, Caulfield, Blackburn, Eltham.',
  },
  {
    area: 'Bayside',
    detail: 'Brighton and the bayside suburbs: made-to-measure tables for family homes, coastal-inspired dining rooms, and interior design projects.',
  },
  {
    area: 'Mornington Peninsula',
    detail: 'Statement timber dining tables for relaxed living, entertaining, and coastal-inspired interiors.',
  },
  {
    area: 'Bass Coast and Phillip Island',
    detail: 'Tables for holiday homes, coastal renovations, and permanent seaside living, with Studio delivery from $199.',
  },
  {
    area: 'Regional Victoria',
    detail: 'Projects by enquiry, with delivery planning discussed during the quoting process.',
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Contact Level Design',
  description:
    'Contact Level Design with questions about a Studio table or your order, delivery quotes, and custom timber dining table projects in Melbourne, Victoria, and Australia-wide by enquiry.',
  about: {
    '@type': 'Service',
    name: 'Melbourne custom dining table enquiries',
    areaServed: serviceAreas.map((item) => ({
      '@type': 'Place',
      name: item.area,
    })),
  },
};
---

<Layout
  title="Contact Level Design | Questions, Orders & Projects"
  description="Ask about a Studio table or your order, get a delivery quote, or start a custom project. Melbourne-based makers, with Australia-wide delivery."
  schema={schema}
>
  <!-- Hidden form for Netlify detection -->
  <form name="contact-enquiry" data-netlify="true" data-netlify-honeypot="bot-field" style="display:none">
    <input name="topic" />
    <input name="name" /><input name="email" /><input name="phone" />
    <input name="preferredTable" /><input name="orderReference" /><input name="deliveryPostcode" /><input name="practice" />
    <textarea name="message"></textarea>
    <input name="dimensions" />
    <textarea name="projectDetails"></textarea>
    <input name="timberPreference" /><input name="budgetRange" /><input name="timeline" />
  </form>
  <div>

    <!-- Hero -->
    <section class="relative bg-gradient-to-r from-[#3d4f47] to-[#2d3f37] text-white pt-28 pb-12 md:pt-32 md:min-h-[24rem] flex items-center overflow-hidden">
      <div class="absolute inset-0 opacity-10">
        <div class="absolute top-0 left-0 w-96 h-96 bg-[#c8956a] rounded-full blur-3xl"></div>
      </div>

      <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl">
          <p class="hero-in text-[#c8956a] font-medium mb-4 tracking-wider uppercase text-sm" style="--delay: 0.2s">Contact</p>
          <h1 class="hero-in text-4xl sm:text-5xl md:text-6xl font-serif mb-6" style="--delay: 0.4s">Get in Touch</h1>
          <p class="hero-in text-lg sm:text-xl text-[#e8dcc8] mb-8" style="--delay: 0.6s">
            A question about a Studio table or your order, delivery to your area, or a custom project — send us a message and we'll come back to you.
          </p>
          <div class="hero-in flex flex-wrap gap-4" style="--delay: 0.8s">
            {["Response within 2 business days", "One-on-one design support"].map((item) => (
              <div class="px-4 py-2 bg-[#2d3f37] rounded-full text-sm flex items-center gap-2">
                <svg class="w-4 h-4 text-[#c8956a]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                {item}
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Form -->
    <section class="py-16 md:py-20 bg-white">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <SectionHeader
          eyebrow="Send a Message"
          title="How Can We Help?"
          description="Tell us what it's about and we'll take it from there. For a custom project, we'll suggest the best direction for dimensions, design and finish."
          wrapperClass="text-center mb-12"
          descriptionClass="text-xl text-[#5a6b64]"
        />
        <ContactForm client:visible />
      </div>
    </section>

    <!-- Studio shortcut -->
    <section class="py-10 bg-[#f5f1e8]">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="reveal flex flex-col sm:flex-row items-center justify-between gap-4 bg-white rounded-2xl p-6 md:p-8 shadow-sm border border-[#e8dcc8]">
          <div>
            <p class="text-[#c8956a] font-medium text-sm mb-1">Looking for something more affordable?</p>
            <p class="text-[#3d4f47]">If you'd rather skip the enquiry, the Studio Collection offers the same design standard at a more accessible price — order online today.</p>
          </div>
          <a href="/studio/" class="flex-shrink-0 inline-flex items-center gap-2 px-6 py-3 bg-[#3d4f47] text-white rounded-full hover:bg-[#2d3f37] transition-all duration-300 whitespace-nowrap">
            Shop the Studio Collection →
          </a>
        </div>
      </div>
    </section>

    <!-- Info cards -->
    <section class="py-24 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <SectionHeader
          eyebrow="How to Get in Touch"
          title="We're Here to Help"
          description="Whether you have questions about our tables or want to start a custom project, we're ready to listen."
        />

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-16">
          {[
            {
              svg: `<path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/>`,
              title: "Contact Us",
              detail: "Use the form below",
              note: "Response within 2 business days",
            },
            {
              svg: `<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.62 1.27h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.91a16 16 0 0 0 6.16 6.16l.97-.97a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>`,
              title: "Request a Call",
              detail: "Available for project consultations",
              note: "We'll call at a time that suits you",
            },
            {
              svg: `<path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>`,
              title: "Delivery Area",
              detail: "Custom work: Melbourne-wide. Studio tables: delivered to most major cities.",
              note: "Anywhere else in Australia — reach out and we'll work out the details",
            },
          ].map((card, i) => (
            <div class="reveal bg-[#f5f1e8] rounded-2xl p-8 text-center hover:shadow-lg transition-shadow group" style={`--delay: ${i * 0.1}s`}>
              <div class="w-16 h-16 rounded-2xl bg-[#3d4f47] flex items-center justify-center mx-auto mb-6 group-hover:bg-[#c8956a] transition-colors duration-300">
                <svg class="text-white w-8 h-8" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" set:html={card.svg} />
              </div>
              <h3 class="text-lg font-semibold text-[#3d4f47] mb-2">{card.title}</h3>
              <p class="text-[#5a6b64]">{card.detail}</p>
              <p class="text-sm text-[#5a6b64] mt-3">{card.note}</p>
            </div>
          ))}
        </div>

        <div class="reveal bg-[#f5f1e8] rounded-3xl p-8 md:p-10 mb-16">
          <div class="max-w-3xl mb-8">
            <p class="text-[#c8956a] font-medium mb-4 tracking-wider uppercase text-sm">Service Areas</p>
            <h2 class="text-3xl md:text-4xl font-serif text-[#3d4f47] mb-4">Melbourne and Victorian Table Projects</h2>
            <p class="text-[#5a6b64] text-lg leading-relaxed">
              Level Design is Melbourne-based and works with homeowners, interior designers, and architects on custom timber dining tables across Melbourne, the Bass Coast and wider Victoria. If your project is outside these areas, send through the details and we can advise on delivery options.
            </p>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
            {serviceAreas.map((item, i) => (
              <div class="rounded-2xl bg-white p-6" style={`--delay: ${i * 0.1}s`}>
                <h3 class="text-xl font-semibold text-[#3d4f47] mb-3">{item.area}</h3>
                <p class="text-sm text-[#5a6b64] leading-relaxed">{item.detail}</p>
              </div>
            ))}
          </div>
          <a href="/melbourne-custom-dining-tables/" class="inline-flex mt-8 text-[#c8956a] font-medium hover:underline">
            Read more about custom dining tables in Melbourne →
          </a>
        </div>

        <!-- Helpful info with image -->
        <div class="reveal bg-gradient-to-r from-[#3d4f47] to-[#2d3f37] rounded-3xl overflow-hidden text-white">
          <div class="grid grid-cols-1 lg:grid-cols-2">
            <!-- Image -->
            <div class="relative min-h-[320px] lg:min-h-0">
              <Image
                src={contactImg}
                alt="Level Design timber table in a styled interior"
                class="absolute inset-0 w-full h-full object-cover"
              />
            </div>
            <!-- Tips -->
            <div class="p-8 md:p-12">
              <h3 class="text-2xl font-serif mb-2">Helpful to Include in a Project Enquiry</h3>
              <p class="text-[#e8dcc8] mb-8">The more we know, the better we can help</p>
              <div class="space-y-4">
                {[
                  "Your preferred finish and overall look",
                  "How many seats you need day to day",
                  "Links to tables you like or photos of your space",
                  "Your delivery suburb and any timing considerations",
                ].map((item) => (
                  <div class="flex items-start gap-3 bg-[#2d3f37]/50 rounded-xl p-4">
                    <svg class="text-[#c8956a] flex-shrink-0 mt-0.5 w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                    <span class="text-[#e8dcc8]">{item}</span>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

  </div>
</Layout>
