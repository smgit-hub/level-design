---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm';
import SectionHeader from '../components/SectionHeader.astro';

const serviceAreas = [
  {
    area: 'Melbourne',
    detail: 'Custom timber dining tables for homes, renovations, and design-led residential projects across inner and middle Melbourne, including Toorak, South Yarra, Armadale, Malvern, Kew, Hawthorn, Fitzroy, Northcote, Caulfield, Blackburn, Eltham.',
  },
  {
    area: 'Bayside',
    detail: 'Brighton and the bayside suburbs: made-to-measure tables for family homes, coastal-inspired dining rooms, and interior design projects.',
  },
  {
    area: 'Mornington Peninsula',
    detail: 'Statement timber dining tables for relaxed living, entertaining, and coastal-inspired interiors.',
  },
  {
    area: 'Bass Coast and Phillip Island',
    detail: 'Tables for holiday homes, coastal renovations, and permanent seaside living, with Studio delivery from $199.',
  },
  {
    area: 'Regional Victoria',
    detail: 'Projects by enquiry, with delivery planning discussed during the quoting process.',
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Contact Level Design',
  description:
    'Contact Level Design with questions about a Studio table or your order, delivery quotes, and custom timber dining table projects in Melbourne, Victoria, and Australia-wide by enquiry.',
  about: {
    '@type': 'Service',
    name: 'Melbourne custom dining table enquiries',
    areaServed: serviceAreas.map((item) => ({
      '@type': 'Place',
      name: item.area,
    })),
  },
};
---

<Layout
  title="Contact Level Design | Questions, Orders & Projects"
  description="Ask about a Studio table or your order, get a delivery quote, or start a custom project. Melbourne-based makers, with Australia-wide delivery."
  schema={schema}
>
  <!-- Hidden form for Netlify detection -->
  <form name="contact-enquiry" data-netlify="true" data-netlify-honeypot="bot-field" style="display:none">
    <input name="topic" />
    <input name="name" /><input name="email" /><input name="phone" />
    <input name="preferredTable" /><input name="orderReference" /><input name="deliveryPostcode" /><input name="practice" />
    <textarea name="message"></textarea>
    <input name="dimensions" />
    <textarea name="projectDetails"></textarea>
    <input name="timberPreference" /><input name="budgetRange" /><input name="timeline" />
  </form>
  <div>

    <!-- Hero -->
    <section class="relative bg-gradient-to-r from-[#3d4f47] to-[#2d3f37] text-white pt-28 pb-12 md:pt-32 md:min-h-[24rem] flex items-center overflow-hidden">
      <div class="absolute inset-0 opacity-10">
        <div class="absolute top-0 left-0 w-96 h-96 bg-[#c8956a] rounded-full blur-3xl"></div>
      </div>

      <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl">
          <p class="hero-in text-[#c8956a] font-medium mb-4 tracking-wider uppercase text-sm" style="--delay: 0.2s">Contact</p>
          <h1 class="hero-in text-4xl sm:text-5xl md:text-6xl font-serif mb-6" style="--delay: 0.4s">Get in Touch</h1>
          <p class="hero-in text-lg sm:text-xl text-[#e8dcc8] mb-8" style="--delay: 0.6s">
            A question about a Studio table or your order, delivery to your area, or a custom project — send us a message and we'll come back to you.
          </p>
          <div class="hero-in flex flex-wrap gap-4" style="--delay: 0.8s">
            {["Response within 2 business days", "One-on-one design support"].map((item) => (
              <div class="px-4 py-2 bg-[#2d3f37] rounded-full text-sm flex items-center gap-2">
                <svg class="w-4 h-4 text-[#c8956a]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                {item}
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Form, with what to expect and where we work beside it -->
    <section class="py-16 md:py-20 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1.6fr)_minmax(0,1fr)] gap-10 lg:gap-14 items-start">
          <div>
            <SectionHeader
              eyebrow="Send a Message"
              title="How Can We Help?"
              description="Tell us what it's about and we'll take it from there."
              wrapperClass="mb-8"
              titleClass="text-3xl md:text-4xl font-serif text-[#3d4f47] mb-4"
              descriptionClass="text-lg text-[#5a6b64]"
            />
            <ContactForm client:visible />
          </div>

          <aside class="reveal lg:sticky lg:top-24 rounded-2xl border border-[#e5ddd0] bg-[#faf8f5] p-6 md:p-8 space-y-8" style="--delay: 0.1s">
            <div>
              <p class="text-[#c8956a] font-medium mb-2 uppercase text-sm">What to Expect</p>
              <p class="text-[#5a6b64]">We reply within 2 business days. For a custom project we'll suggest a direction for dimensions, design and finish, and follow with a tailored quote.</p>
            </div>
            <div>
              <p class="text-[#c8956a] font-medium mb-3 uppercase text-sm">Helpful to Include in a Project Enquiry</p>
              <ul class="space-y-3 text-[#3d4f47]">
                {[
                  "Your preferred finish and overall look",
                  "How many seats you need day to day",
                  "Links to tables you like or photos of your space",
                  "Your delivery suburb and any timing considerations",
                ].map((item) => (
                  <li class="flex items-start gap-3">
                    <svg class="text-[#c8956a] flex-shrink-0 mt-0.5 w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
            <div>
              <p class="text-[#c8956a] font-medium mb-2 uppercase text-sm">Where We Work</p>
              <p class="text-[#5a6b64] mb-3">Melbourne, the Bass Coast and Phillip Island, the Mornington Peninsula, Geelong, and regional Victoria by enquiry. If your project is elsewhere, send through the details and we can advise on delivery.</p>
              <a href="/melbourne-custom-dining-tables/" class="text-[#c8956a] font-medium hover:underline">More about where we work →</a>
            </div>
          </aside>
        </div>
      </div>
    </section>

    <!-- Studio shortcut -->
    <section class="py-10 bg-[#f5f1e8]">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="reveal flex flex-col sm:flex-row items-center justify-between gap-4 bg-white rounded-2xl p-6 md:p-8 shadow-sm border border-[#e8dcc8]">
          <div>
            <p class="text-[#c8956a] font-medium text-sm mb-1">Looking for something more affordable?</p>
            <p class="text-[#3d4f47]">If you'd rather skip the enquiry, the Studio Collection offers the same design standard at a more accessible price — order online today.</p>
          </div>
          <a href="/studio/" class="flex-shrink-0 inline-flex items-center gap-2 px-6 py-3 bg-[#3d4f47] text-white rounded-full hover:bg-[#2d3f37] transition-all duration-300 whitespace-nowrap">
            Shop the Studio Collection →
          </a>
        </div>
      </div>
    </section>

  </div>
</Layout>
