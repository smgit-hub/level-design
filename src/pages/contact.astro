---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm';
---

<Layout title="Contact" description="Start your table project. Share your space, style, and timeline and we will come back with the right direction and a tailored quote.">
  <div class="pt-16">

    <!-- Hero -->
    <section class="relative bg-gradient-to-r from-[#3d4f47] to-[#2d3f37] text-white py-20 overflow-hidden">
      <div class="absolute inset-0 opacity-10">
        <div class="absolute top-0 left-0 w-96 h-96 bg-[#c8956a] rounded-full blur-3xl"></div>
      </div>
      <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl">
          <p class="hero-in text-[#c8956a] font-medium mb-4 tracking-wider uppercase text-sm" style="--delay: 0.2s">Let's Build Yours</p>
          <h1 class="hero-in text-5xl md:text-6xl font-serif mb-6" style="--delay: 0.4s">Start Your Table Project</h1>
          <p class="hero-in text-xl text-[#e8dcc8] mb-8" style="--delay: 0.6s">
            Share your space, style, and timeline. We will come back with the right direction and a tailored quote.
          </p>
          <div class="hero-in flex flex-wrap gap-4" style="--delay: 0.8s">
            {["Response within 2 business days", "One-on-one design support"].map((item) => (
              <div class="px-4 py-2 bg-[#2d3f37] rounded-full text-sm flex items-center gap-2">
                <svg class="w-4 h-4 text-[#c8956a]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                {item}
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Info cards -->
    <section class="py-24 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="reveal text-center mb-16">
          <p class="text-[#c8956a] font-medium mb-4 tracking-wider uppercase text-sm">How to Get in Touch</p>
          <h2 class="text-4xl md:text-5xl font-serif text-[#3d4f47] mb-6">We're Here to Help</h2>
          <p class="text-xl text-[#7d8f87] max-w-2xl mx-auto">Whether you have questions about our tables or want to start a custom project, we're ready to listen.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-16">
          {[
            {
              icon: "✉️",
              title: "Email Us",
              detail: "hello@leveldesign.com.au",
              href: "mailto:hello@leveldesign.com.au",
              note: "Response within 2 business days",
            },
            {
              icon: "📞",
              title: "Call or Text",
              detail: "Available for project consultations",
              note: "Weekdays 9am – 5pm AEST",
            },
            {
              icon: "📍",
              title: "Delivery Area",
              detail: "Australia-wide delivery",
              note: "White-glove service included",
            },
          ].map((card, i) => (
            <div class="reveal bg-[#f5f1e8] rounded-2xl p-8 text-center hover:shadow-lg transition-shadow" style={`--delay: ${i * 0.1}s`}>
              <div class="w-14 h-14 rounded-full bg-[#3d4f47] flex items-center justify-center mx-auto mb-4 text-2xl">
                {card.icon}
              </div>
              <h3 class="text-lg font-semibold text-[#3d4f47] mb-2">{card.title}</h3>
              {card.href ? (
                <a href={card.href} class="text-[#c8956a] hover:underline">{card.detail}</a>
              ) : (
                <p class="text-[#7d8f87]">{card.detail}</p>
              )}
              <p class="text-sm text-[#7d8f87] mt-3">{card.note}</p>
            </div>
          ))}
        </div>

        <!-- Helpful info -->
        <div class="reveal bg-gradient-to-r from-[#3d4f47] to-[#2d3f37] rounded-3xl p-8 md:p-12 text-white">
          <div class="max-w-3xl mx-auto">
            <h3 class="text-2xl font-serif mb-2 text-center">Helpful to Include in Your Enquiry</h3>
            <p class="text-[#e8dcc8] text-center mb-8">The more we know, the better we can help</p>
            <div class="grid md:grid-cols-2 gap-4">
              {[
                "Your preferred finish and overall look",
                "How many seats you need day to day",
                "Links to tables you like or photos of your space",
                "Your delivery suburb and any timing considerations",
              ].map((item, i) => (
                <div class="reveal flex items-start gap-3 bg-[#2d3f37]/50 rounded-xl p-4" style={`--delay: ${i * 0.1}s`}>
                  <svg class="text-[#c8956a] flex-shrink-0 mt-0.5 w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                  <span class="text-[#e8dcc8]">{item}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Form -->
    <section class="py-24 bg-[#f5f1e8]">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="reveal text-center mb-12">
          <p class="text-[#c8956a] font-medium mb-4 tracking-wider uppercase text-sm">Get Started</p>
          <h2 class="text-4xl md:text-5xl font-serif text-[#3d4f47] mb-6">Request a Quote</h2>
          <p class="text-xl text-[#7d8f87]">We'll review your requirements and suggest the best direction for dimensions, design, and finish.</p>
        </div>
        <ContactForm client:load />
      </div>
    </section>

  </div>
</Layout>
