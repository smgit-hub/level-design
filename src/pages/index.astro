---
import Layout from '../layouts/Layout.astro';
import { products } from '../data/signature-products';
import { Image } from 'astro:assets';
import SectionHeader from '../components/SectionHeader.astro';
import IconFeatureGrid from '../components/IconFeatureGrid.astro';
import review1 from '../assets/images/home/level-design-customer-review-1.webp';
import review2 from '../assets/images/home/level-design-customer-review-2.webp';
import review3 from '../assets/images/home/level-design-customer-review-3.webp';

const whyChooseItems = [
  {
    title: 'Design-led from the first conversation',
    desc: 'Every project begins with understanding your room, your lifestyle, and how you want the table to work in your home.',
    svg: `<path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>`,
  },
  {
    title: 'Scale, proportion, and material expertise',
    desc: 'We guide you through dimensions, seating, timber species, and finish — every decision made in the context of your specific space.',
    svg: `<path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/>`,
  },
  {
    title: 'Heirloom quality, built for daily life',
    desc: 'Made using traditional joinery and sustainably sourced American and Australian hardwoods, these tables are designed to be used every day and to last generations.',
    svg: `<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>`,
  },
];
---

<Layout
  title="Level Design | Bespoke Dining Table Design Studio Melbourne"
  description="Level Design is a dining table design studio in Melbourne. We create bespoke custom dining tables designed around your space, lifestyle and entertaining needs. Heirloom-quality pieces made to order."
  preloadImage="/images/home/level-design-handcrafted-furniture-hero.webp"
>
  <div>

    <!-- Hero -->
    <section class="hero-parallax relative h-screen flex items-start justify-center overflow-hidden pt-44">
      <picture class="absolute inset-0 w-full h-full">
        <source media="(max-width: 767px)" srcset="/images/home/level-design-handcrafted-furniture-hero-mobile.webp" />
        <img
          src="/images/home/level-design-handcrafted-furniture-hero.webp"
          alt="Level Design handcrafted timber table"
          class="w-full h-full object-cover object-[center_70%]"
        />
      </picture>
      <div class="absolute inset-0 bg-gradient-to-b from-[#1a241f]/75 via-[#1a241f]/40 to-[#1a241f]/20"></div>

      <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-white">
        <div class="max-w-3xl">
          <p class="hero-in text-[#c8956a] font-medium mb-4 tracking-wider uppercase text-sm drop-shadow-lg" style="--delay: 0.3s">
            Handcrafted in Melbourne
          </p>
          <h1 class="hero-in text-5xl md:text-7xl font-serif mb-6 drop-shadow-2xl" style="--delay: 0.5s">
            Bespoke Dining Tables<br /> Designed for How You Live
          </h1>
          <p class="hero-in text-xl md:text-2xl text-[#e8dcc8] mb-8 leading-relaxed drop-shadow-lg" style="--delay: 0.7s">
            Every table begins with your space, your lifestyle, and the way you entertain. Designed and made to last generations.
          </p>
          <div class="hero-in flex flex-col sm:flex-row gap-4" style="--delay: 0.9s">
            <a href="/custom/" class="btn-scale inline-flex items-center gap-2 px-8 py-4 bg-[#c8956a] text-white rounded-full hover:bg-[#b8856a] transition-all duration-300 shadow-lg hover:shadow-xl">
              Begin a Design Consultation →
            </a>
            <a href="/signature/" class="btn-scale inline-flex items-center gap-2 px-8 py-4 bg-white/90 backdrop-blur-sm border-2 border-white text-[#3d4f47] rounded-full hover:bg-white transition-all duration-300 shadow-lg">
              Explore the Collection
            </a>
          </div>
        </div>
      </div>

      <!-- Scroll indicator -->
      <div class="absolute bottom-8 left-1/2 -translate-x-1/2">
        <div class="scroll-bounce">
          <div class="w-6 h-10 rounded-full border-2 border-white/50 flex items-start justify-center p-2">
            <div class="w-1 h-2 bg-white/50 rounded-full"></div>
          </div>
        </div>
      </div>
    </section>

    <!-- Stats -->
    <section class="py-20 bg-[#f5f1e8]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {[
            { value: "200+", label: "Tables Designed", desc: "Each one shaped around a specific brief" },
            { value: "10+", label: "Years of Practice", desc: "Designing around how people live" },
            { value: "1:1", label: "Design Consultation", desc: "Every project begins with a conversation" },
          ].map((stat, i) => (
            <div class="reveal text-center p-8 rounded-2xl bg-white shadow-sm hover:shadow-xl transition-shadow duration-300" style={`--delay: ${i * 0.1}s`}>
              <div class="text-5xl font-serif text-[#3d4f47] mb-2">{stat.value}</div>
              <div class="text-xl font-semibold text-[#3d4f47] mb-2">{stat.label}</div>
              <div class="text-sm text-[#5a6b64]">{stat.desc}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Featured Tables -->
    <section class="py-24 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <SectionHeader
          eyebrow="The Collection"
          title="Signature Designs, Each Available as a Custom Commission"
          description="Our collection of dining table designs serves as a starting point. Every piece can be discussed in custom dimensions, alternative timbers, and tailored finishes to suit your specific room and brief."
          wrapperClass="text-center mb-12"
          descriptionClass="text-lg text-[#5a6b64] max-w-3xl mx-auto"
        />

        <!-- Editorial bento grid -->
        <div class="grid grid-cols-1 md:grid-cols-3 md:grid-rows-2 gap-4 md:h-[620px] mb-12">

          <!-- Large feature card: Pillar Table -->
          <a href="/signature/pillar/" class="reveal group relative md:col-span-2 md:row-span-2 rounded-2xl overflow-hidden min-h-[400px]">
            <img src={products.pillar.images.main} alt="Pillar Table" loading="lazy" width="1536" height="1413" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
            <div class="absolute inset-0 bg-gradient-to-t from-[#1a2820]/90 via-[#1a2820]/20 to-transparent"></div>
            <div class="absolute bottom-0 left-0 right-0 p-8 md:p-10">
              <p class="text-[#c8956a] text-xs font-semibold tracking-widest uppercase mb-2">Featured Design</p>
              <h3 class="text-3xl md:text-4xl font-serif text-white mb-2">Pillar Table</h3>
              <p class="text-[#e8dcc8] text-sm md:text-base mb-5 max-w-sm">Statement base and generous top for entertaining at scale.</p>
              <span class="inline-flex items-center gap-2 text-white text-sm font-medium border-b border-white/40 pb-0.5 group-hover:border-white transition-colors duration-300">View Table →</span>
            </div>
          </a>

          <!-- Luna Table -->
          <a href="/signature/luna/" class="reveal group relative rounded-2xl overflow-hidden min-h-[290px]" style="--delay: 0.1s">
            <img src={products.luna.images.main} alt="Luna Table" loading="lazy" width="788" height="786" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
            <div class="absolute inset-0 bg-gradient-to-t from-[#1a2820]/85 via-transparent to-transparent"></div>
            <div class="absolute bottom-0 left-0 right-0 p-6">
              <h3 class="text-xl font-serif text-white mb-1">Luna Table</h3>
              <p class="text-[#e8dcc8] text-xs mb-3">Elegant curves meet modern functionality.</p>
              <span class="inline-flex items-center gap-1 text-white text-xs font-medium border-b border-white/40 pb-0.5 group-hover:border-white transition-colors duration-300">View →</span>
            </div>
          </a>

          <!-- Yama Table -->
          <a href="/signature/yama/" class="reveal group relative rounded-2xl overflow-hidden min-h-[290px]" style="--delay: 0.2s">
            <img src={products.yama.images.main} alt="Yama Table" loading="lazy" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
            <div class="absolute inset-0 bg-gradient-to-t from-[#1a2820]/85 via-transparent to-transparent"></div>
            <div class="absolute bottom-0 left-0 right-0 p-6">
              <h3 class="text-xl font-serif text-white mb-1">Yama Table</h3>
              <p class="text-[#e8dcc8] text-xs mb-3">Clean lines with natural warmth.</p>
              <span class="inline-flex items-center gap-1 text-white text-xs font-medium border-b border-white/40 pb-0.5 group-hover:border-white transition-colors duration-300">View →</span>
            </div>
          </a>

        </div>

        <div class="reveal text-center">
          <a href="/signature/" class="btn-scale inline-flex items-center gap-2 px-8 py-4 bg-[#3d4f47] text-white rounded-full hover:bg-[#2d3f37] transition-all duration-300 shadow-lg hover:shadow-xl">
            View the Full Collection →
          </a>
        </div>
      </div>
    </section>

    <!-- Why Choose Us -->
    <section class="py-24 bg-[#f5f1e8]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <SectionHeader
          eyebrow="Our Approach"
          title="Why People Choose Level Design"
          description="We design dining tables around our clients' spaces, lifestyles, and entertaining needs. Here's what that looks like in practice."
        />
        <IconFeatureGrid items={whyChooseItems} />
      </div>
    </section>

    <!-- Featured Projects -->
    <section class="py-24 bg-[#f5f1e8]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <SectionHeader
          eyebrow="Featured Projects"
          title="Every Table Begins with a Unique Brief"
          description="Explore a selection of dining tables designed around our clients' spaces, lifestyles and entertaining needs."
          wrapperClass="mb-12"
          descriptionClass="text-lg text-[#5a6b64] max-w-2xl"
        />

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {[
            {
              name: "Sarah Mitchell",
              role: "Interior Designer, South Yarra",
              content: "The craftsmanship is exceptional. Our Pillar Table has become the centrepiece of our dining room.",
              tableLabel: "Pillar Table — American Oak",
              projectId: "pillar",
              img: review1,
              pos: "object-center"
            },
            {
              name: "Emma Thompson",
              role: "Architect, Fitzroy",
              content: "I recommend Level Design to all my clients. Their attention to detail and quality is unmatched.",
              tableLabel: "Venn Table — American Oak",
              projectId: "venn",
              img: review3,
              pos: "object-bottom"
            },
            {
              name: "James Chen",
              role: "Homeowner, Brighton",
              content: "Working with Level Design was a dream. They understood our vision and delivered beyond expectations.",
              tableLabel: "Luna Table — Tasmanian Oak",
              projectId: "luna",
              img: review2,
              pos: "object-center"
            },
          ].map((t, i) => (
            <a href={`/projects/#project-${t.projectId}`} class="reveal group rounded-2xl bg-white shadow-sm hover:shadow-lg transition-all duration-300 overflow-hidden block border border-transparent hover:border-[#e8dcc8]" style={`--delay: ${i * 0.1}s`}>
              <div class="aspect-[4/3] overflow-hidden">
                <Image src={t.img} alt={`${t.name}'s dining space`} loading="lazy" class={`w-full h-full object-cover ${t.pos} group-hover:scale-105 transition-transform duration-500`} />
              </div>
              <div class="p-8 relative">
                <p class="text-xs font-semibold tracking-widest uppercase text-[#c8956a] mb-3">{t.tableLabel}</p>
                <p class="text-[#3d4f47] text-lg font-serif italic leading-relaxed mb-4">"{t.content}"</p>
                <div class="border-t border-[#e8dcc8] pt-4 flex items-center justify-between">
                  <div>
                    <div class="font-semibold text-[#3d4f47] text-sm">{t.name}</div>
                    <div class="text-xs text-[#5a6b64] mt-0.5">{t.role}</div>
                  </div>
                  <span class="text-[#c8956a] text-xs font-medium opacity-0 group-hover:opacity-100 transition-opacity duration-300">View project →</span>
                </div>
              </div>
            </a>
          ))}
        </div>

        <div class="reveal text-center mt-12">
          <a href="/projects/" class="btn-scale inline-flex items-center gap-2 px-8 py-4 bg-[#3d4f47] text-white rounded-full hover:bg-[#2d3f37] transition-all duration-300 shadow-lg hover:shadow-xl">
            View All Projects →
          </a>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-24 bg-gradient-to-r from-[#3d4f47] to-[#2d3f37] text-white relative overflow-hidden">
      <div class="absolute inset-0 opacity-10">
        <div class="absolute top-0 left-0 w-96 h-96 bg-[#c8956a] rounded-full blur-3xl"></div>
        <div class="absolute bottom-0 right-0 w-96 h-96 bg-[#c8956a] rounded-full blur-3xl"></div>
      </div>
      <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <div class="reveal">
          <h2 class="text-4xl md:text-5xl font-serif mb-6">Ready to Design Your Table?</h2>
          <p class="text-xl text-[#e8dcc8] mb-8 max-w-2xl mx-auto">Every project begins with a conversation. Tell us about your space and how you use it — we'll take it from there.</p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="/custom/" class="btn-scale inline-flex items-center gap-2 px-8 py-4 bg-[#c8956a] text-white rounded-full hover:bg-[#b8856a] transition-all duration-300 shadow-lg hover:shadow-xl">
              Begin a Design Consultation →
            </a>
            <a href="/signature/" class="btn-scale inline-flex items-center gap-2 px-8 py-4 bg-transparent border-2 border-white text-white rounded-full hover:bg-white hover:text-[#3d4f47] transition-all duration-300">
              Explore the Collection
            </a>
          </div>
        </div>
      </div>
    </section>

  </div>
</Layout>
