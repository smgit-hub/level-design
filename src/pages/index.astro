---
import Layout from '../layouts/Layout.astro';
import { products } from '../data/signature-products';
import { allStudioProducts, startingPrice as getStartingPrice } from '../data/studio-products';
import StudioShapeIcon from '../components/StudioShapeIcon.astro';
import SectionHeader from '../components/SectionHeader.astro';
import IconFeatureGrid from '../components/IconFeatureGrid.astro';

const formatPrice = (cents: number) =>
  new Intl.NumberFormat('en-AU', { style: 'currency', currency: 'AUD', maximumFractionDigits: 0 }).format(cents / 100);

const whyChooseItems = [
  {
    title: 'Design something bespoke, or order now',
    desc: 'Start a design consultation for a bespoke commission, or choose a design from the Studio Collection — the same design standard, at a more accessible price.',
    svg: `<path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>`,
  },
  {
    title: 'Scale, proportion, and material expertise',
    desc: 'Every design — bespoke or Studio — is guided by the same decade of expertise in dimensions, seating, timber species, and finish.',
    svg: `<path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/>`,
  },
  {
    title: 'Built for daily life, made to last',
    desc: 'Every design, bespoke or Studio, is built to be used every day and to last.',
    svg: `<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>`,
  },
];
---

<Layout
  title="Level Design | Dining Tables Melbourne — Buy Now or Bespoke"
  description="Shop dining tables online from the Studio Collection, or start a bespoke design consultation with Level Design, Melbourne. Both built to last."
  preloadImage="/images/home/level-design-handcrafted-furniture-hero.webp"
>
  <div>

    <!-- Hero -->
    <section class="hero-parallax relative h-screen flex items-start justify-center overflow-hidden pt-44 md:pt-24">
      <picture class="absolute inset-0 w-full h-full">
        <source media="(max-width: 767px)" srcset="/images/home/level-design-handcrafted-furniture-hero-mobile.webp" />
        <img
          src="/images/home/level-design-handcrafted-furniture-hero.webp"
          alt="Level Design handcrafted timber table"
          class="w-full h-full object-cover object-[center_70%] md:object-top"
        />
      </picture>
      <div class="absolute inset-0 bg-gradient-to-b from-[#1a241f]/75 via-[#1a241f]/40 to-[#1a241f]/20"></div>

      <div class="relative z-10 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-white">
        <div class="max-w-4xl md:max-w-6xl md:mx-auto md:text-center">
          <a href="/studio/" class="hero-in inline-flex items-center gap-2 mb-5 md:mb-4 bg-white/10 backdrop-blur-sm border border-white/40 text-white text-sm px-4 py-1.5 rounded-full hover:bg-white/20 transition-colors duration-300" style="--delay: 0.15s">
            <span class="bg-[#c8956a] text-white text-[10px] font-bold uppercase tracking-wide px-2 py-0.5 rounded-full">New</span>
            The Studio Collection has landed — shop now →
          </a>
          <p class="hero-in text-[#f0d9bd] font-medium mb-3 md:mb-2 tracking-wider uppercase text-sm drop-shadow-lg" style="--delay: 0.3s">
            Handcrafted in Melbourne
          </p>
          <h1 class="hero-in text-5xl md:text-6xl lg:text-7xl font-serif mb-6 md:mb-4 drop-shadow-2xl" style="--delay: 0.5s">
            Dining Tables<br class="md:hidden" /> for How You Live
          </h1>
          <p class="hero-in text-xl md:text-2xl text-[#e8dcc8] mb-8 md:mb-6 leading-relaxed drop-shadow-lg" style="--delay: 0.7s">
            Thoughtfully designed and expertly made — built to last.
          </p>
          <div class="hero-in flex flex-col sm:flex-row md:justify-center gap-4" style="--delay: 0.9s">
            <a href="/studio/" class="btn-scale inline-flex items-center gap-2 px-8 py-4 bg-[#c8956a] text-white rounded-full hover:bg-[#b8856a] transition-all duration-300 shadow-lg hover:shadow-xl">
              Shop the Studio Collection →
            </a>
            <a href="/custom/" class="btn-scale inline-flex items-center gap-2 px-8 py-4 bg-white/10 backdrop-blur-sm border-2 border-white text-white rounded-full hover:bg-white hover:text-[#3d4f47] transition-all duration-300">
              Design a Custom Table
            </a>
          </div>
        </div>
      </div>

      <!-- Scroll indicator -->
      <div class="absolute bottom-8 left-1/2 -translate-x-1/2">
        <div class="scroll-bounce">
          <div class="w-6 h-10 rounded-full border-2 border-white/50 flex items-start justify-center p-2">
            <div class="w-1 h-2 bg-white/50 rounded-full"></div>
          </div>
        </div>
      </div>
    </section>

    <!-- Stats -->
    <section class="py-8 md:py-10 bg-white">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-3 gap-4 text-center">
          {[
            { value: "200+", label: "Tables designed" },
            { value: "10+", label: "Years of practice" },
            { value: "2", label: "Ways to get one" },
          ].map((stat, i) => (
            <div class="reveal" style={`--delay: ${i * 0.1}s`}>
              <div class="text-3xl md:text-4xl font-serif text-[#3d4f47]">{stat.value}</div>
              <div class="text-xs md:text-sm text-[#5a6b64] mt-1">{stat.label}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Featured Studio Tables -->
    <section class="py-24 bg-[#f5f1e8]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <SectionHeader
          eyebrow="The Studio Collection"
          title="Considered Design, Ready to Order"
          description="Four oak designs in a set of fixed sizes — the same design standard as Signature, at a more accessible price."
          wrapperClass="text-center mb-12"
          descriptionClass="text-lg text-[#5a6b64] max-w-3xl mx-auto"
        />

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-12">
          {allStudioProducts.map((table, i) => (
            <a
              href={`/studio/${table.id}/`}
              class="reveal group rounded-2xl overflow-hidden bg-white shadow-sm hover:shadow-xl transition-all duration-300"
              style={`--delay: ${i * 0.1}s`}
            >
              <div class="aspect-[4/3] lg:aspect-[3/2] overflow-hidden">
                <img src={table.images.gallery[0] ?? table.images.main} alt={table.name} loading="lazy" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
              </div>
              <div class="flex items-end justify-between gap-4 p-4 lg:p-5">
                <div>
                  <h3 class="text-lg lg:text-2xl font-serif text-[#3d4f47] group-hover:text-[#c8956a] transition-colors mb-1">{table.name}</h3>
                  <p class="text-[#5a6b64] text-xs lg:text-sm flex items-center gap-2"><StudioShapeIcon product={table} /><span>{table.shape}</span></p>
                </div>
                <p class="text-[#c8956a] font-semibold text-sm lg:text-base whitespace-nowrap">From {formatPrice(getStartingPrice(table))}</p>
              </div>
            </a>
          ))}
        </div>

        <div class="reveal text-center">
          <a href="/studio/" class="btn-scale inline-flex items-center gap-2 px-8 py-4 bg-[#3d4f47] text-white rounded-full hover:bg-[#2d3f37] transition-all duration-300 shadow-lg hover:shadow-xl">
            View the Full Studio Collection →
          </a>
        </div>
      </div>
    </section>

    <!-- Featured Tables -->
    <section class="py-24 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <SectionHeader
          eyebrow="Want something bespoke?"
          title="Signature Designs, Each Available as a Custom Commission"
          description="Our collection of dining table designs serves as a starting point. Every piece can be discussed in custom dimensions, alternative timbers, and tailored finishes to suit your specific room and brief."
          wrapperClass="text-center mb-12"
          descriptionClass="text-lg text-[#5a6b64] max-w-3xl mx-auto"
        />

        <!-- Editorial bento grid -->
        <div class="grid grid-cols-1 md:grid-cols-3 md:grid-rows-2 gap-4 md:h-[620px] mb-12">

          <!-- Large feature card: Pillar Table -->
          <a href="/signature/pillar/" class="reveal group relative md:col-span-2 md:row-span-2 rounded-2xl overflow-hidden min-h-[400px]">
            <img src={products.pillar.images.main} alt="Pillar Table" loading="lazy" width="1536" height="1413" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
            <div class="absolute inset-0 bg-gradient-to-t from-[#1a2820]/85 via-[#1a2820]/40 via-35% to-transparent to-65%"></div>
            <div class="absolute bottom-0 left-0 right-0 p-8 md:p-10">
              <p class="text-[#c8956a] text-xs font-semibold tracking-widest uppercase mb-2">Featured Design</p>
              <h3 class="text-3xl md:text-4xl font-serif text-white mb-2">Pillar Table</h3>
              <p class="text-[#e8dcc8] text-sm md:text-base mb-5 max-w-sm">Statement base and generous top for entertaining at scale.</p>
              <span class="inline-flex items-center gap-2 text-white text-sm font-medium border-b border-white/40 pb-0.5 group-hover:border-white transition-colors duration-300">View Table →</span>
            </div>
          </a>

          <!-- Luna Table -->
          <a href="/signature/luna/" class="reveal group relative rounded-2xl overflow-hidden min-h-[290px]" style="--delay: 0.1s">
            <img src={products.luna.images.main} alt="Luna Table" loading="lazy" width="788" height="786" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
            <div class="absolute inset-0 bg-gradient-to-t from-[#1a2820]/85 via-transparent via-45% to-transparent"></div>
            <div class="absolute bottom-0 left-0 right-0 p-6">
              <h3 class="text-xl font-serif text-white mb-1">Luna Table</h3>
              <p class="text-[#e8dcc8] text-xs mb-3">Elegant curves meet modern functionality.</p>
              <span class="inline-flex items-center gap-1 text-white text-xs font-medium border-b border-white/40 pb-0.5 group-hover:border-white transition-colors duration-300">View →</span>
            </div>
          </a>

          <!-- Yama Table -->
          <a href="/signature/yama/" class="reveal group relative rounded-2xl overflow-hidden min-h-[290px]" style="--delay: 0.2s">
            <img src={products.yama.images.main} alt="Yama Table" loading="lazy" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
            <div class="absolute inset-0 bg-gradient-to-t from-[#1a2820]/85 via-transparent via-45% to-transparent"></div>
            <div class="absolute bottom-0 left-0 right-0 p-6">
              <h3 class="text-xl font-serif text-white mb-1">Yama Table</h3>
              <p class="text-[#e8dcc8] text-xs mb-3">Clean lines with natural warmth.</p>
              <span class="inline-flex items-center gap-1 text-white text-xs font-medium border-b border-white/40 pb-0.5 group-hover:border-white transition-colors duration-300">View →</span>
            </div>
          </a>

        </div>

        <div class="reveal text-center">
          <a href="/signature/" class="btn-scale inline-flex items-center gap-2 px-8 py-4 bg-[#3d4f47] text-white rounded-full hover:bg-[#2d3f37] transition-all duration-300 shadow-lg hover:shadow-xl">
            View the Full Collection →
          </a>
        </div>
      </div>
    </section>

    <!-- Press: about the custom work, so it sits with the bespoke section and not under the Studio cards -->
    <section class="py-12 md:py-14 bg-[#f5f1e8]">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <p class="reveal text-[#c8956a] font-medium mb-3 tracking-wider uppercase text-sm">In the press</p>
        <p class="reveal text-2xl md:text-3xl font-serif text-[#3d4f47] mb-3" style="--delay: 0.1s">Our bespoke work has been featured in Belle and Houzz</p>
        <a href="/projects/" class="reveal text-[#c8956a] font-medium hover:underline" style="--delay: 0.2s">See our projects →</a>
      </div>
    </section>

    <!-- Why Choose Us -->
    <section class="py-24 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <SectionHeader
          eyebrow="Our Approach"
          title="Why People Choose Level Design"
          description="We design dining tables around our clients' spaces, lifestyles, and entertaining needs. Here's what that looks like in practice."
        />
        <IconFeatureGrid items={whyChooseItems} />
      </div>
    </section>

    <!-- Featured Projects -->
    <section class="py-24 bg-[#f5f1e8]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <SectionHeader
          eyebrow="Featured Projects"
          title="Every Bespoke Table Begins with a Unique Brief"
          description="Three commissions, in our clients' own words."
          wrapperClass="mb-12"
          descriptionClass="text-lg text-[#5a6b64] max-w-2xl"
        />

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {[
            {
              role: "Interior Designer, Fitzroy",
              content: "The craftsmanship is exceptional. Our Pillar Table has become the centrepiece of our dining room.",
              tableLabel: "Pillar Table — American Oak",
              projectId: "pillar",
              // Same lead image as the Pillar project on the Projects page: the fourth photo on the Pillar page
              img: products.pillar.images.gallery[2],
              pos: "object-[center_55%]",
              zoom: "scale-[1.18] origin-bottom group-hover:scale-[1.23]"
            },
            {
              role: "Interior Designer, South Yarra",
              content: "I recommend Level Design to all my clients. Their attention to detail and quality is unmatched.",
              tableLabel: "Venn Table — American Oak",
              projectId: "venn",
              img: products.venn.images.main,
              pos: "object-center",
              zoom: "scale-[1.18] origin-bottom group-hover:scale-[1.23]"
            },
            {
              role: "Homeowner, Brighton",
              content: "Working with Level Design was a dream. They understood our vision and delivered beyond expectations.",
              tableLabel: "Luna Table — Tasmanian Oak",
              projectId: "luna",
              // Same lead image as the Luna project on the Projects page: the third photo on the Luna page
              img: products.luna.images.gallery[1],
              pos: "object-[center_55%]"
            },
          ].map((t, i) => (
            <a href={`/projects/#project-${t.projectId}`} class="reveal group rounded-2xl bg-white shadow-sm hover:shadow-lg transition-all duration-300 overflow-hidden block border border-transparent hover:border-[#e8dcc8]" style={`--delay: ${i * 0.1}s`}>
              <div class="aspect-[4/3] overflow-hidden">
                <img src={t.img} alt={t.tableLabel.split(' — ')[0]} loading="lazy" width="1536" height="1024" class={`w-full h-full object-cover ${t.pos} ${t.zoom ?? 'group-hover:scale-105'} transition-transform duration-500`} />
              </div>
              <div class="p-8 relative">
                <p class="text-xs font-semibold tracking-widest uppercase text-[#c8956a] mb-3">{t.tableLabel}</p>
                <p class="text-[#3d4f47] text-lg font-serif italic leading-relaxed mb-4">"{t.content}"</p>
                <div class="border-t border-[#e8dcc8] pt-4 flex items-center justify-between">
                  <div>
                    <div class="font-semibold text-[#3d4f47] text-sm">{t.role}</div>
                  </div>
                  <span class="text-[#c8956a] text-xs font-medium opacity-0 group-hover:opacity-100 transition-opacity duration-300">View project →</span>
                </div>
              </div>
            </a>
          ))}
        </div>

        <p class="reveal text-center text-xs text-[#8a9b94] mt-8">Client names withheld for privacy.</p>

        <div class="reveal text-center mt-6">
          <a href="/projects/" class="btn-scale inline-flex items-center gap-2 px-8 py-4 bg-[#3d4f47] text-white rounded-full hover:bg-[#2d3f37] transition-all duration-300 shadow-lg hover:shadow-xl">
            View All Projects →
          </a>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-24 bg-gradient-to-r from-[#3d4f47] to-[#2d3f37] text-white relative overflow-hidden">
      <div class="absolute inset-0 opacity-10">
        <div class="absolute top-0 left-0 w-96 h-96 bg-[#c8956a] rounded-full blur-3xl"></div>
        <div class="absolute bottom-0 right-0 w-96 h-96 bg-[#c8956a] rounded-full blur-3xl"></div>
      </div>
      <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <div class="reveal">
          <h2 class="text-4xl md:text-5xl font-serif mb-6">Order One Today, or Design Your Own</h2>
          <p class="text-xl text-[#e8dcc8] mb-8 max-w-2xl mx-auto">Order straight from the Studio Collection — the same design standard, at a more accessible price — or start a bespoke commission with a design consultation.</p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="/studio/" class="btn-scale inline-flex items-center gap-2 px-8 py-4 bg-[#c8956a] text-white rounded-full hover:bg-[#b8856a] transition-all duration-300 shadow-lg hover:shadow-xl">
              Shop the Studio Collection →
            </a>
            <a href="/custom/" class="btn-scale inline-flex items-center gap-2 px-8 py-4 bg-transparent border-2 border-white text-white rounded-full hover:bg-white hover:text-[#3d4f47] transition-all duration-300">
              Begin a Design Consultation
            </a>
          </div>
        </div>
      </div>
    </section>

  </div>
</Layout>
