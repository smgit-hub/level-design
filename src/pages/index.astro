---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Home" description="Design-led timber tables made for everyday living, hosting, and lasting use.">
  <div class="pt-16">

    <!-- Hero -->
    <section class="hero-parallax relative h-[90vh] flex items-center justify-center overflow-hidden bg-gradient-to-br from-[#2d3f37] via-[#3d4f47] to-[#4d6057]">
      <div class="absolute inset-0 opacity-10">
        <div class="absolute top-0 left-0 w-96 h-96 bg-[#c8956a] rounded-full blur-3xl"></div>
        <div class="absolute bottom-0 right-0 w-96 h-96 bg-[#c8956a] rounded-full blur-3xl"></div>
      </div>

      <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-white">
        <div class="max-w-3xl">
          <p class="hero-in text-[#c8956a] font-medium mb-4 tracking-wider uppercase text-sm drop-shadow-lg" style="--delay: 0.3s">
            Design-Led Timber Tables
          </p>
          <h1 class="hero-in text-5xl md:text-7xl font-serif mb-6 drop-shadow-2xl" style="--delay: 0.5s">
            Modern Tables Built Around Real Life
          </h1>
          <p class="hero-in text-xl md:text-2xl text-[#e8dcc8] mb-8 leading-relaxed drop-shadow-lg" style="--delay: 0.7s">
            Join over 250 families who've chosen quality craft. Made to measure, designed for your space, built to last generations.
          </p>
          <div class="hero-in flex flex-col sm:flex-row gap-4" style="--delay: 0.9s">
            <a href="/custom" class="btn-scale inline-flex items-center gap-2 px-8 py-4 bg-[#c8956a] text-white rounded-full hover:bg-[#b8856a] transition-all duration-300 shadow-lg hover:shadow-xl">
              Design Yours →
            </a>
            <a href="/tables" class="btn-scale inline-flex items-center gap-2 px-8 py-4 bg-white/90 backdrop-blur-sm border-2 border-white text-[#3d4f47] rounded-full hover:bg-white transition-all duration-300 shadow-lg">
              Explore Gallery
            </a>
          </div>
        </div>
      </div>

      <!-- Scroll indicator -->
      <div class="scroll-bounce absolute bottom-8 left-1/2">
        <div class="w-6 h-10 rounded-full border-2 border-white/50 flex items-start justify-center p-2">
          <div class="w-1 h-2 bg-white/50 rounded-full"></div>
        </div>
      </div>
    </section>

    <!-- Stats -->
    <section class="py-20 bg-[#f5f1e8]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {[
            { value: "250+", label: "Tables Crafted", desc: "Handcrafted with precision" },
            { value: "Local", label: "Australian Made", desc: "Supporting local makers" },
            { value: "1:1", label: "Personal Service", desc: "Direct collaboration" },
          ].map((stat, i) => (
            <div class="reveal text-center p-8 rounded-2xl bg-white shadow-sm hover:shadow-xl transition-shadow duration-300" style={`--delay: ${i * 0.1}s`}>
              <div class="text-5xl font-serif text-[#3d4f47] mb-2">{stat.value}</div>
              <div class="text-xl font-semibold text-[#3d4f47] mb-2">{stat.label}</div>
              <div class="text-sm text-[#7d8f87]">{stat.desc}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Featured Tables -->
    <section class="py-24 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="reveal text-center mb-16">
          <p class="text-[#c8956a] font-medium mb-4 tracking-wider uppercase text-sm">Explore Our Collection</p>
          <h2 class="text-4xl md:text-5xl font-serif text-[#3d4f47] mb-6">Find the Right Table for Your Room</h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-12">
          {[
            { id: "pillar", name: "Pillar Table", desc: "Statement base and generous top for entertaining at scale." },
            { id: "luna", name: "Luna Table", desc: "Elegant curves meet modern functionality." },
            { id: "yama", name: "Yama Table", desc: "Clean lines with natural warmth." },
          ].map((table, i) => (
            <div class="reveal" style={`--delay: ${i * 0.1}s`}>
              <a href={`/tables/${table.id}`} class="group block rounded-2xl overflow-hidden bg-[#f5f1e8] shadow-sm hover:shadow-2xl transition-all duration-500">
                <div class="aspect-[4/3] overflow-hidden bg-gradient-to-br from-[#3d4f47] to-[#2d3f37] flex items-end p-6">
                  <span class="text-white/30 font-serif text-2xl">{table.name}</span>
                </div>
                <div class="p-6">
                  <h3 class="text-2xl font-semibold text-[#3d4f47] mb-2 group-hover:text-[#c8956a] transition-colors">{table.name}</h3>
                  <p class="text-[#7d8f87] mb-4">{table.desc}</p>
                  <div class="flex items-center gap-2 text-[#c8956a] font-medium">
                    Learn more
                    <span class="group-hover:translate-x-2 transition-transform duration-300 inline-block">→</span>
                  </div>
                </div>
              </a>
            </div>
          ))}
        </div>

        <div class="reveal text-center">
          <a href="/tables" class="btn-scale inline-flex items-center gap-2 px-8 py-4 bg-[#3d4f47] text-white rounded-full hover:bg-[#2d3f37] transition-all duration-300 shadow-lg hover:shadow-xl">
            View Full Collection →
          </a>
        </div>
      </div>
    </section>

    <!-- Why Choose Us -->
    <section class="py-24 bg-[#f5f1e8]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="reveal text-center mb-16">
          <p class="text-[#c8956a] font-medium mb-4 tracking-wider uppercase text-sm">Our Approach</p>
          <h2 class="text-4xl md:text-5xl font-serif text-[#3d4f47] mb-6">Why People Choose Level Design</h2>
          <p class="text-xl text-[#7d8f87] max-w-2xl mx-auto">Thoughtful design, local production, and person-to-person care set us apart.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {[
            { title: "Sustainably Sourced", desc: "We use certified sustainable timber from responsible Australian suppliers.", svg: `<path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/>` },
            { title: "Bespoke Design", desc: "Every table is made to order. Choose dimensions, timber species, and finish.", svg: `<path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>` },
            { title: "Lifetime Craftsmanship", desc: "Built to last generations with traditional joinery techniques and premium materials.", svg: `<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>` },
          ].map((item, i) => (
            <div class="reveal p-8 rounded-2xl bg-white hover:shadow-xl transition-all duration-300 group" style={`--delay: ${i * 0.1}s`}>
              <div class="w-16 h-16 rounded-2xl bg-[#3d4f47] flex items-center justify-center mb-6 group-hover:bg-[#c8956a] transition-colors duration-300">
                <svg class="text-white w-8 h-8" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" set:html={item.svg} />
              </div>
              <h3 class="text-2xl font-semibold text-[#3d4f47] mb-4">{item.title}</h3>
              <p class="text-[#7d8f87]">{item.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Process -->
    <section class="py-24 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="reveal text-center mb-16">
          <p class="text-[#c8956a] font-medium mb-4 tracking-wider uppercase text-sm">How It Works</p>
          <h2 class="text-4xl md:text-5xl font-serif text-[#3d4f47] mb-6">A Simple Process from Idea to Delivery</h2>
          <p class="text-xl text-[#7d8f87] max-w-2xl mx-auto">From idea to delivery, we guide you through a streamlined process that puts you in control.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
          {[
            { number: "01", title: "Brief", desc: "Share your space, style, preferences, and delivery timing." },
            { number: "02", title: "Design", desc: "We recommend construction, materials, and finish combinations." },
            { number: "03", title: "Craft", desc: "Your table is made by hand with close attention to detail." },
            { number: "04", title: "Deliver", desc: "We coordinate final delivery and aftercare guidance." },
          ].map((step, i) => (
            <div class="reveal relative" style={`--delay: ${i * 0.1}s`}>
              <div class="text-7xl font-serif text-[#e8dcc8] mb-4">{step.number}</div>
              <h3 class="text-2xl font-semibold text-[#3d4f47] mb-4">{step.title}</h3>
              <p class="text-[#7d8f87]">{step.desc}</p>
              {i < 3 && <div class="hidden lg:block absolute top-12 -right-4 w-8 h-0.5 bg-[#e8dcc8]"></div>}
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Testimonials -->
    <section class="py-24 bg-[#f5f1e8]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="reveal text-center mb-16">
          <p class="text-[#c8956a] font-medium mb-4 tracking-wider uppercase text-sm">Client Stories</p>
          <h2 class="text-4xl md:text-5xl font-serif text-[#3d4f47] mb-6">Loved by Families and Hosts</h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {[
            { name: "Sarah Mitchell", role: "Interior Designer", content: "The craftsmanship is exceptional. Our Pillar Table has become the centrepiece of our dining room.", rating: 5 },
            { name: "James Chen", role: "Homeowner", content: "Working with Level Design was a dream. They understood our vision and delivered beyond expectations.", rating: 5 },
            { name: "Emma Thompson", role: "Architect", content: "I recommend Level Design to all my clients. Their attention to detail and quality is unmatched.", rating: 5 },
          ].map((t, i) => (
            <div class="reveal p-8 rounded-2xl bg-white shadow-sm hover:shadow-xl transition-shadow duration-300" style={`--delay: ${i * 0.1}s`}>
              <div class="flex gap-1 mb-4">
                {Array.from({ length: t.rating }).map((_, j) => (
                  <svg key={j} class="w-5 h-5 fill-[#c8956a] text-[#c8956a]" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                ))}
              </div>
              <p class="text-[#3d4f47] mb-6 text-lg italic">"{t.content}"</p>
              <div>
                <div class="font-semibold text-[#3d4f47]">{t.name}</div>
                <div class="text-sm text-[#7d8f87]">{t.role}</div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-24 bg-gradient-to-r from-[#3d4f47] to-[#2d3f37] text-white relative overflow-hidden">
      <div class="absolute inset-0 opacity-10">
        <div class="absolute top-0 left-0 w-96 h-96 bg-[#c8956a] rounded-full blur-3xl"></div>
        <div class="absolute bottom-0 right-0 w-96 h-96 bg-[#c8956a] rounded-full blur-3xl"></div>
      </div>
      <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <div class="reveal">
          <h2 class="text-4xl md:text-5xl font-serif mb-6">Ready to Design Your Perfect Table?</h2>
          <p class="text-xl text-[#e8dcc8] mb-8 max-w-2xl mx-auto">Let's create something beautiful together. Start your custom design journey today.</p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="/custom" class="btn-scale inline-flex items-center gap-2 px-8 py-4 bg-[#c8956a] text-white rounded-full hover:bg-[#b8856a] transition-all duration-300 shadow-lg hover:shadow-xl">
              Start Your Design →
            </a>
            <a href="/tables" class="btn-scale inline-flex items-center gap-2 px-8 py-4 bg-transparent border-2 border-white text-white rounded-full hover:bg-white hover:text-[#3d4f47] transition-all duration-300">
              Browse Collections
            </a>
          </div>
        </div>
      </div>
    </section>

  </div>
</Layout>
