---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import SectionHeader from '../components/SectionHeader.astro';
import aboutImg from '../assets/images/about/level-design-about-image.webp';
import belleImg from '../assets/images/about/level-design-belle-magazine-custom-table.webp';
import houzzImg from '../assets/images/about/level-design-houzz-magazine-coffee-table.webp';
import workshopImg from '../assets/images/about/level-design-workshop.webp';

const valueItems = [
  {
    title: 'Designed around how you live',
    desc: "The best table is designed around the people who use it — a bespoke commission shaped around your brief, or a Studio design chosen to fit how you live.",
    svg: '<path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>',
  },
  {
    title: 'Honest materials',
    desc: 'Signature tables are mostly solid timber. Studio tables use real oak veneer over a stable substrate, with a solid oak base on the Line Table. We always tell you exactly what a table is made from.',
    svg: '<circle cx="12" cy="8" r="7"></circle><polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"></polyline>',
  },
  {
    title: 'Considered detail',
    desc: 'Overall proportions, edge profile, leg placement and finish are decided with your room in mind, not left to chance.',
    svg: '<path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/>',
  },
];
---

<Layout title="About Level Design | Dining Table Design Studio Melbourne" description="Level Design is a Melbourne dining table studio: bespoke commissions plus the Studio Collection. Our bespoke work has been featured in Belle and Houzz.">
  <div>

    <!-- Hero -->
    <section class="relative pt-28 pb-12 md:pt-32 md:min-h-[24rem] flex items-center bg-gradient-to-r from-[#3d4f47] to-[#2d3f37] text-white overflow-hidden">
      <div class="absolute inset-0 opacity-10">
        <div class="absolute -top-24 -right-24 w-96 h-96 bg-[#c8956a] rounded-full blur-3xl"></div>
      </div>
      <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl">
          <p class="hero-in text-[#c8956a] font-medium mb-4 tracking-wider uppercase text-sm" style="--delay: 0.2s">About Level Design</p>
          <h1 class="hero-in text-4xl sm:text-5xl md:text-6xl font-serif mb-6" style="--delay: 0.4s">A Dining Table Design Studio Based in Melbourne</h1>
          <p class="hero-in text-lg sm:text-xl text-[#e8dcc8] leading-relaxed mb-8" style="--delay: 0.6s">
            For more than 10 years, we've designed bespoke dining tables shaped around the people who commission them — and more recently, the Studio Collection, a small range of ready-to-order tables.
          </p>
          <div class="hero-in flex flex-wrap gap-4" style="--delay: 0.8s">
            {["10+ years of design expertise", "Bespoke work featured in Belle and Houzz", "Made in Melbourne"].map((item) => (
              <div class="px-4 py-2 bg-[#2d3f37] rounded-full text-sm flex items-center gap-2">
                <svg class="w-4 h-4 text-[#c8956a]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                {item}
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Story -->
    <section class="py-16 md:py-24 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          <div class="reveal-left">
            <p class="text-[#c8956a] font-medium mb-4 tracking-wider uppercase text-sm">The Practice</p>
            <h2 class="text-4xl md:text-5xl font-serif text-[#3d4f47] mb-6">
              We Design Dining Tables Around the People Who Will Use Them
            </h2>
            <div class="space-y-6 text-[#5a6b64] text-lg">
              <p>Level Design is a dining table design studio. We work with clients across Melbourne and Australia to design bespoke dining tables shaped around their specific rooms, the way they live, and the way they entertain.</p>
              <p>Every bespoke commission begins with understanding the space — its proportions, its material palette, the people who gather around it, and what they need the table to do. The design follows from that understanding, not from a fixed specification.</p>
              <p>Alongside these bespoke commissions, we also offer the <a href="/studio/" class="text-[#c8956a] hover:underline">Studio Collection</a> — a small range of ready-to-order tables, built to the same standard of craft, with a 6–8 week lead time. Everything is designed in Melbourne and made with American and Australian hardwoods by skilled local craftspeople.</p>
              <p>We also work closely with interior designers and architects on their clients' projects — <a href="/projects/#designers" class="text-[#c8956a] hover:underline">see how we work together</a>.</p>
            </div>
          </div>
          <div class="reveal-right relative">
            <div class="relative z-10 aspect-[4/5] rounded-2xl overflow-hidden shadow-2xl">
              <Image src={aboutImg} alt="Level Design table in a beautifully designed interior" loading="lazy" class="w-full h-full object-cover" />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Workshop -->
    <section class="py-16 md:py-24 bg-[#f5f1e8]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center">
          <div class="reveal-left">
            <div class="aspect-[4/5] max-w-md mx-auto lg:max-w-none rounded-2xl overflow-hidden">
              <Image src={workshopImg} alt="A Level Design craftsperson machining timber in the Melbourne workshop" loading="lazy" class="w-full h-full object-cover" />
            </div>
          </div>
          <div class="reveal-right">
            <p class="text-[#c8956a] font-medium mb-4 tracking-wider uppercase text-sm">Made in Melbourne</p>
            <h2 class="text-3xl md:text-5xl font-serif text-[#3d4f47] mb-6">Cut, Shaped and Finished in Melbourne</h2>
            <div class="space-y-5 text-[#5a6b64] text-lg">
              <p>Every Level Design table is made in Melbourne by skilled craftspeople, from the first cut of the timber to the final finish.</p>
              <p>Bespoke commissions and Studio tables alike are made to order, so each one is made for you rather than pulled from a shelf.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Values -->
    <section class="py-16 md:py-24 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <SectionHeader
          eyebrow="Our Approach"
          title="What Guides Our Work"
          wrapperClass="text-center mb-10 md:mb-14"
          titleClass="text-3xl md:text-5xl font-serif text-[#3d4f47]"
        />
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-10">
          {valueItems.map((item, i) => (
            <div class="reveal flex gap-4" style={`--delay: ${i * 0.1}s`}>
              <div class="w-12 h-12 flex-shrink-0 rounded-xl bg-[#3d4f47] flex items-center justify-center">
                <svg class="text-white w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" set:html={item.svg} />
              </div>
              <div>
                <h3 class="text-lg font-semibold text-[#3d4f47] mb-1">{item.title}</h3>
                <p class="text-[#5a6b64] text-sm leading-relaxed">{item.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Magazine -->
    <section class="py-16 md:py-24 bg-[#f5f1e8]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          <div class="reveal-left order-2 lg:order-1">
            <div class="grid grid-cols-2 gap-4 items-start">
              <figure>
                <div class="aspect-[4/3] rounded-xl overflow-hidden">
                  <Image src={belleImg} alt="Level Design table featured in Belle magazine" loading="lazy" class="w-full h-full object-cover" />
                </div>
                <figcaption class="mt-3 text-xs uppercase tracking-[0.14em] text-[#5a6b64]">Featured in Belle</figcaption>
              </figure>
              <figure>
                <div class="aspect-[3/4] rounded-xl overflow-hidden">
                  <Image src={houzzImg} alt="Level Design table featured in Houzz" loading="lazy" class="w-full h-full object-cover" />
                </div>
                <figcaption class="mt-3 text-xs uppercase tracking-[0.14em] text-[#5a6b64]">Featured on Houzz</figcaption>
              </figure>
            </div>
          </div>
          <div class="reveal-right order-1 lg:order-2">
            <p class="text-[#c8956a] font-medium mb-4 tracking-wider uppercase text-sm">Magazine Features</p>
            <h2 class="text-4xl font-serif text-[#3d4f47] mb-6">Tables That Photograph Well Because They Live Well</h2>
            <p class="text-[#5a6b64] text-lg mb-6">Our work has appeared in magazines that highlight thoughtful Australian design and interiors. But for us, the real measure of success is seeing our tables become part of daily life in the homes they inhabit.</p>
            <p class="text-[#5a6b64] text-lg">Open form, honest materials, and craftsmanship that stays beautiful over years of use.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-16 md:py-24 bg-gradient-to-r from-[#3d4f47] to-[#2d3f37] text-white">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <div class="reveal">
          <p class="text-[#c8956a] font-medium mb-4 tracking-wider uppercase text-sm">Work With Us</p>
          <h2 class="text-3xl md:text-5xl font-serif mb-6">Design a Table for Your Room</h2>
          <p class="text-xl text-[#e8dcc8] mb-8 max-w-2xl mx-auto">Tell us about your space and we'll design around it, or order a Studio table today.</p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="/custom/" class="btn-scale inline-flex items-center justify-center gap-2 px-8 py-4 bg-[#c8956a] text-white rounded-full hover:bg-[#b8856a] transition-all duration-300">
              Begin a Design Consultation →
            </a>
            <a href="/studio/" class="btn-scale inline-flex items-center justify-center gap-2 px-8 py-4 bg-transparent border-2 border-white text-white rounded-full hover:bg-white hover:text-[#3d4f47] transition-all duration-300">
              Shop the Studio Collection
            </a>
          </div>
        </div>
      </div>
    </section>

  </div>
</Layout>
