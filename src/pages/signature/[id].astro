---
import Layout from '../../layouts/Layout.astro';
import ProductDetailClient from '../../components/ProductDetailClient';
import FaqAccordion from '../../components/FaqAccordion.astro';
import { allProducts } from '../../data/signature-products';

export function getStaticPaths() {
  return allProducts.map((p) => ({
    params: { id: p.id },
    props: { product: p },
  }));
}

const { product } = Astro.props;
const index = allProducts.findIndex((p) => p.id === product.id);
const prev = allProducts[(index - 1 + allProducts.length) % allProducts.length];
const next = allProducts[(index + 1) % allProducts.length];
const productUrl = `/signature/${product.id}/`;
const pageDescription = `${product.name} — ${product.tagline}. Designed and made in Melbourne, with custom sizing available.`;
const productFaqs = [
  {
    question: `Can ${product.name} be made in a different size, timber, or finish?`,
    answer: `Yes. ${product.name} can be tailored in size, proportion, timber species, and finish to better suit your room, seating requirements, and interior palette.`,
  },
  {
    question: `Is ${product.name} suitable for Melbourne homes and design projects?`,
    answer: `Yes. Level Design works with Melbourne homeowners, interior designers, and architects to create dining tables that balance everyday practicality with a strong design outcome.`,
  },
  {
    question: `How does ${product.name} arrive?`,
    answer: `${product.name} is made in two parts, the top and the base, and arrives that way. Delivery includes assembly, so we put it together in your room and there is nothing for you to build. We'll check access, such as stairs, lifts, doorways and parking, when we arrange your delivery date.`,
  },
];
const schema = [
  // Signature designs are bespoke and have no fixed price, so they are described as a page about a design. Marking them
  // up as a Product with no price would be flagged by Google as incomplete.
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: `${product.name} — Signature Collection`,
    description: pageDescription,
    url: new URL(productUrl, Astro.site ?? Astro.url.origin).toString(),
    primaryImageOfPage: {
      '@type': 'ImageObject',
      url: new URL(product.images.main, Astro.site ?? Astro.url.origin).toString(),
    },
    about: {
      '@type': 'Thing',
      name: `${product.name} dining table design`,
      description: product.description,
    },
    publisher: { '@type': 'Organization', name: 'Level Design Australia Pty Ltd' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: new URL('/', Astro.site ?? Astro.url.origin).toString(),
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Signature',
        item: new URL('/signature/', Astro.site ?? Astro.url.origin).toString(),
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: product.name,
        item: new URL(productUrl, Astro.site ?? Astro.url.origin).toString(),
      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: productFaqs.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
];
---

<Layout
  title={`${product.name} | Custom Dining Table, Melbourne | Level Design`}
  description={pageDescription}
  ogImage={product.images.main}
  ogType="product"
  schema={schema}
>
  <!-- Hidden form for Netlify detection -->
  <form name="table-enquiry" data-netlify="true" data-netlify-honeypot="bot-field" style="display:none">
    <input name="table" /><input name="name" /><input name="email" /><input name="phone" />
    <input name="dimensions" /><textarea name="projectDetails"></textarea>
    <input name="timberPreference" /><input name="budgetRange" /><input name="timeline" />
  </form>
  <ProductDetailClient product={product} prev={{ id: prev.id, name: prev.name }} next={{ id: next.id, name: next.name }} client:load />

  <section class="py-16 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
        <div class="reveal">
          <h2 class="text-3xl font-serif text-[#3d4f47] mb-4">{product.name} for Your Project</h2>
          <p class="text-[#5a6b64] text-lg leading-relaxed">
            The shown {product.specifications['Dimensions Shown']} in {product.specifications['Timber / Finish Shown']} is a starting point — size, timber, and finish are discussed and adjusted to fit your room. If you'd like a different proportion or material direction, the <a href="/custom/" class="text-[#c8956a] hover:underline">custom dining table process</a> is the best next step.
          </p>
        </div>
        <div class="reveal bg-[#f5f1e8] rounded-3xl p-8 md:p-10" style="--delay: 0.1s">
          <h2 class="text-2xl font-serif text-[#3d4f47] mb-6">{product.name} FAQs</h2>
          <FaqAccordion items={productFaqs} />
        </div>
      </div>

      <div class="reveal mt-12 text-center" style="--delay: 0.15s">
        <p class="text-[#5a6b64] text-lg mb-6">Still comparing options? Explore the full <a href="/signature/" class="text-[#c8956a] hover:underline">Signature Collection</a>, browse the <a href="/studio/" class="text-[#c8956a] hover:underline">Studio Collection</a>, or <a href="/contact/" class="text-[#c8956a] hover:underline">request guidance</a> on the right size and finish for your space.</p>
      </div>
    </div>
  </section>
</Layout>
