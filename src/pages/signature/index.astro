---
import Layout from '../../layouts/Layout.astro';
import { allProducts } from '../../data/signature-products';

const faqs = [
  {
    question: 'How does the custom design process work?',
    answer:
      'Every project begins with a conversation about your space, seating requirements, lifestyle, and material preferences. From there we work through proportions, design direction, and finish together — refining until the table feels right for your room before production begins.',
  },
  {
    question: 'Can any design in the collection be made to a custom size?',
    answer:
      'Yes. Every design in the collection is a starting point, not a fixed specification. We regularly adapt dimensions, seating capacity, edge profiles, and base designs to better suit individual rooms and briefs.',
  },
  {
    question: 'What timber species and finishes are available?',
    answer:
      'We work primarily with American Oak, Tasmanian Oak, and American Ash. Finish options range from raw matte and clear matte through to black satin, black wash, and custom tones — each selected in the context of your interior palette and how the table will be used.',
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};
---

<Layout
  title="Dining Table Collection | Custom Timber Dining Tables Melbourne | Level Design"
  description="Explore Level Design's collection of bespoke dining table designs. Each design is available as a custom commission — tailored to your space, seating requirements, timber preference, and finish."
  schema={schema}
>
  <div>

    <!-- Hero -->
    <section class="relative bg-gradient-to-r from-[#3d4f47] to-[#2d3f37] text-white pt-36 pb-20 min-h-[30rem] flex items-center overflow-hidden">
      <div class="absolute inset-0 opacity-10">
        <div class="absolute top-0 right-0 w-96 h-96 bg-[#c8956a] rounded-full blur-3xl"></div>
      </div>
      <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl">
          <p class="hero-in text-[#c8956a] font-medium mb-4 tracking-wider uppercase text-sm" style="--delay: 0.2s">The Signature Collection</p>
          <h1 class="hero-in text-5xl md:text-6xl font-serif mb-6" style="--delay: 0.4s">A Curated Portfolio of Dining Table Designs</h1>
          <p class="hero-in text-xl text-[#e8dcc8] mb-8" style="--delay: 0.6s">
            Solid-timber-led designs, each available as a bespoke commission — adapted to your space, material palette, and the way you live.
          </p>
          <div class="hero-in flex flex-wrap gap-4" style="--delay: 0.8s">
            {["9 signature designs", "Available as custom commissions", "Sustainably sourced timber"].map((item) => (
              <div class="px-4 py-2 bg-[#2d3f37] rounded-full text-sm flex items-center gap-2">
                <svg class="w-4 h-4 text-[#c8956a]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                {item}
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Tables Grid -->
    <section class="py-20 bg-[#f5f1e8]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="reveal max-w-4xl mb-12">
          <p class="text-[#5a6b64] text-lg leading-relaxed mb-5">
            The Signature Collection represents the design directions we work from at Level Design — solid-timber-led construction, built and finished by hand. Each piece has been resolved in proportion, material, and construction, and each one is available as a custom commission, sized and finished to suit your specific room and brief.
          </p>
          <p class="text-[#5a6b64] text-lg leading-relaxed mb-5">
            Whether you're drawn to a sculptural pedestal table for a formal dining space, a long rectangular design for open-plan entertaining, or a round table that encourages conversation in a more intimate setting — the collection is a starting point, not a catalogue. Every design can be discussed, adapted, and made to feel like it belongs in your home.
          </p>
          <p class="text-[#5a6b64] text-lg leading-relaxed">
            Looking for a fixed-price, ready-to-order table instead of a bespoke commission? Explore the <a href="/studio/" class="text-[#c8956a] font-medium hover:underline">Studio Collection</a> — engineered veneer construction, built for value without a design consultation.
          </p>
          <a href="/melbourne-custom-dining-tables/" class="inline-flex mt-6 text-[#c8956a] font-medium hover:underline">
            See our Melbourne custom dining table service →
          </a>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {allProducts.map((table, i) => (
            <a
              href={`/signature/${table.id}/`}
              class="reveal group rounded-2xl overflow-hidden bg-white shadow-sm hover:shadow-xl transition-all duration-300"
              style={`--delay: ${(i % 3) * 0.1}s`}
            >
              <div class="aspect-[4/3] overflow-hidden">
                <img
                  src={table.images.main}
                  alt={table.name}
                  loading="lazy"
                  width="1536"
                  height="1024"
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                />
              </div>
              <div class="p-6">
                <h3 class="text-xl font-semibold text-[#3d4f47] mb-1 group-hover:text-[#c8956a] transition-colors">{table.name}</h3>
                <p class="text-[#5a6b64] text-sm">{table.tagline}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Custom CTA -->
    <section class="py-20 bg-[#f5f1e8]">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <div class="reveal bg-gradient-to-r from-[#3d4f47] to-[#2d3f37] rounded-3xl p-12 text-white">
          <p class="text-sm uppercase tracking-wider text-[#c8956a] mb-4">Custom Design Consultation</p>
          <h2 class="text-3xl md:text-4xl font-serif mb-4">Don't See Exactly What You're Looking For?</h2>
          <p class="text-[#e8dcc8] mb-8 max-w-2xl mx-auto">
            Every table we make begins with a brief. Tell us about your space, your seating needs, and how you entertain — and we'll design around that.
          </p>
          <a href="/custom/" class="btn-scale inline-flex items-center gap-2 px-8 py-4 bg-[#c8956a] text-white rounded-full hover:bg-[#b8856a] transition-all duration-300 shadow-lg hover:shadow-xl">
            Begin a Design Consultation
          </a>
        </div>
      </div>
    </section>

    <section class="py-20 bg-white">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="reveal text-center mb-14">
          <p class="text-[#c8956a] font-medium mb-4 tracking-wider uppercase text-sm">Design Considerations</p>
          <h2 class="text-4xl md:text-5xl font-serif text-[#3d4f47] mb-6">Choosing the Right Design for Your Space</h2>
          <p class="text-xl text-[#5a6b64] max-w-3xl mx-auto">The right dining table is about more than aesthetics. Proportion, seating capacity, base design, timber species, and finish all shape how the piece works — and feels — in your specific room.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-14">
          {[
            {
              title: 'Proportion and scale first',
              body: 'A table that is too large overwhelms a room; one that is too small reads as an afterthought. We start with your floor plan and work outward from there — ensuring circulation, seating comfort, and visual balance are all resolved.',
            },
            {
              title: 'Design the table around your lifestyle',
              body: 'How many people do you seat on a typical evening? How often do you entertain larger groups? Round tables work beautifully for intimate settings; long rectangular tops suit open-plan living and larger gatherings.',
            },
            {
              title: 'Materials chosen for your interior and your life',
              body: 'Timber species and finish affect tone, grain character, and how the table ages over time. We guide you through the options in the context of your interior palette and how the table will be used day-to-day.',
            },
          ].map((item, i) => (
            <div class="reveal rounded-2xl bg-[#f5f1e8] p-8" style={`--delay: ${i * 0.1}s`}>
              <h3 class="text-2xl font-semibold text-[#3d4f47] mb-4">{item.title}</h3>
              <p class="text-[#5a6b64] leading-relaxed">{item.body}</p>
            </div>
          ))}
        </div>

        <div class="reveal bg-[#f5f1e8] rounded-3xl p-8 md:p-10">
          <h2 class="text-3xl font-serif text-[#3d4f47] mb-8">Bespoke Dining Table FAQs</h2>
          <div class="space-y-6">
            {faqs.map((item) => (
              <div class="border-b border-[#d9cfbd] pb-6 last:border-b-0 last:pb-0">
                <h3 class="text-xl font-semibold text-[#3d4f47] mb-3">{item.question}</h3>
                <p class="text-[#5a6b64] leading-relaxed">{item.answer}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

  </div>
</Layout>
