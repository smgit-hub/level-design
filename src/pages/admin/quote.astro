---
import Layout from '../../layouts/Layout.astro';
import { allStudioProducts } from '../../data/studio-products';

// Only names, sizes and prices go to the page (all public already); the passphrase is checked by the function.
const products = allStudioProducts.map((p) => ({
  id: p.id,
  name: p.name,
  sizes: p.sizes.map((s) => ({ id: s.id, label: s.label, price: s.price })),
}));
---

<Layout title="Delivery quote link | Level Design" description="Private tool." noindex>
  <section class="bg-[#f5f1e8] pt-28 pb-20 min-h-screen">
    <div class="max-w-xl mx-auto px-4 sm:px-6">
      <p class="text-[#c8956a] font-medium mb-2 uppercase text-sm">Private</p>
      <h1 class="text-3xl font-serif text-[#3d4f47] mb-2">Delivery quote link</h1>
      <p class="text-[#5a6b64] mb-8">Make a payment link for a Studio table at the delivery price you've quoted. It can be paid once, and the usual order emails are sent when it is.</p>

      <div class="bg-white rounded-2xl p-6 md:p-8 mb-6 border border-[#e8dcc8] space-y-4">
        <div>
          <label for="q-key" class="block text-sm font-medium text-[#3d4f47] mb-2">Passphrase</label>
          <input id="q-key" type="password" autocomplete="current-password" class="w-full px-4 py-3 border border-[#e8dcc8] rounded-lg bg-white focus:outline-none focus:ring-2 focus:ring-[#c8956a]" />
        </div>
        <div class="flex flex-wrap items-center gap-3">
          <button type="button" id="q-load-list" class="px-5 py-2.5 border border-[#3d4f47] text-[#3d4f47] rounded-full text-sm font-medium hover:bg-[#3d4f47] hover:text-white cursor-pointer">Show open quote requests</button>
          <span id="q-list-status" class="text-sm text-[#5a6b64]" role="status"></span>
        </div>
        <ul id="q-list" class="space-y-2"></ul>
      </div>

      <div id="q-banner" class="hidden mb-6 rounded-2xl bg-[#e8dcc8]/60 p-5 text-sm text-[#3d4f47] space-y-3" aria-live="polite">
        <p id="q-banner-text" class="font-medium"></p>
        <p id="q-banner-message" class="text-[#5a6b64] whitespace-pre-line"></p>
        <div class="flex flex-wrap gap-3">
          <button type="button" id="q-load-request" class="hidden px-4 py-2 bg-[#3d4f47] text-white rounded-full text-sm font-medium hover:bg-[#2d3f37] cursor-pointer">Load this request</button>
          <button type="button" id="q-mark-done" class="hidden px-4 py-2 border border-[#3d4f47] text-[#3d4f47] rounded-full text-sm font-medium hover:bg-[#3d4f47] hover:text-white cursor-pointer">Mark as done</button>
          <button type="button" id="q-clear-request" class="hidden px-4 py-2 text-[#5a6b64] underline underline-offset-2 text-sm cursor-pointer">Clear</button>
        </div>
      </div>

      <form id="quote-form" data-products={JSON.stringify(products)} class="bg-white rounded-2xl p-6 md:p-8 space-y-5 border border-[#e8dcc8]">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <div>
            <label for="q-product" class="block text-sm font-medium text-[#3d4f47] mb-2">Table</label>
            <select id="q-product" required class="w-full px-4 py-3 border border-[#e8dcc8] rounded-lg bg-white focus:outline-none focus:ring-2 focus:ring-[#c8956a]">
              {products.map((p) => <option value={p.id}>{p.name}</option>)}
            </select>
          </div>
          <div>
            <label for="q-size" class="block text-sm font-medium text-[#3d4f47] mb-2">Size</label>
            <select id="q-size" required class="w-full px-4 py-3 border border-[#e8dcc8] rounded-lg bg-white focus:outline-none focus:ring-2 focus:ring-[#c8956a]"></select>
          </div>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <div>
            <label for="q-delivery" class="block text-sm font-medium text-[#3d4f47] mb-2">Delivery price ($)</label>
            <input id="q-delivery" type="number" inputmode="decimal" min="0" max="5000" step="1" required placeholder="e.g. 450" class="w-full px-4 py-3 border border-[#e8dcc8] rounded-lg bg-white focus:outline-none focus:ring-2 focus:ring-[#c8956a]" />
          </div>
          <div>
            <label for="q-postcode" class="block text-sm font-medium text-[#3d4f47] mb-2">Delivery postcode (optional)</label>
            <input id="q-postcode" type="text" inputmode="numeric" maxlength="4" pattern="[0-9]{4}" placeholder="e.g. 3220" class="w-full px-4 py-3 border border-[#e8dcc8] rounded-lg bg-white focus:outline-none focus:ring-2 focus:ring-[#c8956a]" />
          </div>
        </div>
        <div>
          <label for="q-for" class="block text-sm font-medium text-[#3d4f47] mb-2">Customer name (optional, used in the email)</label>
          <input id="q-for" type="text" maxlength="80" class="w-full px-4 py-3 border border-[#e8dcc8] rounded-lg bg-white focus:outline-none focus:ring-2 focus:ring-[#c8956a]" />
        </div>
        <p id="q-total" class="text-sm text-[#5a6b64]" aria-live="polite"></p>
        <p id="q-error" role="alert" class="text-sm text-red-700 hidden"></p>
        <button id="q-submit" type="submit" class="w-full px-6 py-4 bg-[#3d4f47] text-white rounded-full hover:bg-[#2d3f37] transition-colors font-medium disabled:opacity-60 cursor-pointer">Create payment link</button>
      </form>

      <div id="q-result" class="hidden mt-8 bg-white rounded-2xl p-6 md:p-8 border border-[#e8dcc8] space-y-4" aria-live="polite">
        <p id="q-summary" class="text-[#3d4f47] font-medium"></p>
        <p id="q-mode" class="text-xs font-medium uppercase tracking-wide"></p>
        <div>
          <label for="q-link" class="block text-sm font-medium text-[#3d4f47] mb-2">Payment link</label>
          <input id="q-link" type="text" readonly class="w-full px-4 py-3 border border-[#e8dcc8] rounded-lg bg-[#f5f1e8] text-sm" />
        </div>
        <div class="rounded-xl bg-[#f5f1e8] p-5 space-y-4">
          <p class="text-sm font-medium text-[#3d4f47]">Email the quote to the customer</p>
          <p class="text-xs text-[#5a6b64]">Sent from Level Design with the quote, the pay button and what happens next. A copy comes to the order inbox, and their replies go there too.</p>
          <div>
            <label for="q-email" class="block text-sm font-medium text-[#3d4f47] mb-2">Customer email</label>
            <input id="q-email" type="email" autocomplete="off" class="w-full px-4 py-3 border border-[#e8dcc8] rounded-lg bg-white focus:outline-none focus:ring-2 focus:ring-[#c8956a]" />
          </div>
          <div>
            <label for="q-note" class="block text-sm font-medium text-[#3d4f47] mb-2">Personal note (optional)</label>
            <textarea id="q-note" rows="3" maxlength="600" placeholder="e.g. Lovely to chat today. Delivery to you is a little further, so this is the best price I can offer." class="w-full px-4 py-3 border border-[#e8dcc8] rounded-lg bg-white focus:outline-none focus:ring-2 focus:ring-[#c8956a]"></textarea>
          </div>
          <p id="q-send-status" role="status" class="text-sm hidden"></p>
          <button type="button" id="q-send" class="px-5 py-2.5 bg-[#c8956a] text-white rounded-full text-sm font-medium hover:bg-[#b8856a] disabled:opacity-60 cursor-pointer">Send email to customer</button>
        </div>
        <div>
          <label for="q-reply" class="block text-sm font-medium text-[#3d4f47] mb-2">Or copy a draft reply to send yourself</label>
          <textarea id="q-reply" rows="8" readonly class="w-full px-4 py-3 border border-[#e8dcc8] rounded-lg bg-[#f5f1e8] text-sm"></textarea>
        </div>
        <div class="flex flex-wrap gap-3">
          <button type="button" id="q-copy-link" class="px-5 py-2.5 bg-[#3d4f47] text-white rounded-full text-sm font-medium hover:bg-[#2d3f37] cursor-pointer">Copy link</button>
          <button type="button" id="q-copy-reply" class="px-5 py-2.5 border border-[#3d4f47] text-[#3d4f47] rounded-full text-sm font-medium hover:bg-[#3d4f47] hover:text-white cursor-pointer">Copy reply</button>
        </div>
        <p class="text-xs text-[#5a6b64]">To cancel a link, deactivate it under Payment links in the Stripe dashboard.</p>
      </div>
    </div>
  </section>
</Layout>

<script>
  type Size = { id: string; label: string; price: number };
  type Product = { id: string; name: string; sizes: Size[] };

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const money = (cents: number) =>
    new Intl.NumberFormat('en-AU', { style: 'currency', currency: 'AUD', maximumFractionDigits: 0 }).format(cents / 100);

  function init() {
    const form = document.getElementById('quote-form') as HTMLFormElement | null;
    if (!form || form.dataset.ready) return;
    form.dataset.ready = 'yes';
    const products: Product[] = JSON.parse(form.dataset.products || '[]');
    const productEl = $<HTMLSelectElement>('q-product');
    const sizeEl = $<HTMLSelectElement>('q-size');
    const deliveryEl = $<HTMLInputElement>('q-delivery');
    const keyEl = $<HTMLInputElement>('q-key');
    const totalEl = $('q-total');
    const errorEl = $('q-error');
    const submitEl = $<HTMLButtonElement>('q-submit');
    const resultEl = $('q-result');
    let lastQuote: { url: string; productId: string; sizeId: string; deliveryDollars: string; postcode: string } | null = null;

    try {
      keyEl.value = sessionStorage.getItem('ld-quote-key') || '';
    } catch {
      /* storage unavailable: the passphrase is simply typed each time */
    }

    const currentSize = () => products.find((p) => p.id === productEl.value)?.sizes.find((s) => s.id === sizeEl.value);
    const fillSizes = () => {
      const product = products.find((p) => p.id === productEl.value);
      sizeEl.innerHTML = '';
      product?.sizes.forEach((s) => sizeEl.add(new Option(`${s.label} — ${money(s.price)}`, s.id)));
      showTotal();
    };
    const showTotal = () => {
      const size = currentSize();
      const delivery = Number(deliveryEl.value);
      totalEl.textContent =
        size && deliveryEl.value !== '' && Number.isFinite(delivery)
          ? `Table ${money(size.price)} + delivery ${money(Math.round(delivery * 100))} = ${money(size.price + Math.round(delivery * 100))} total`
          : '';
    };
    productEl.addEventListener('change', fillSizes);
    sizeEl.addEventListener('change', showTotal);
    deliveryEl.addEventListener('input', showTotal);
    fillSizes();

    const copy = async (text: string, button: HTMLElement) => {
      try {
        await navigator.clipboard.writeText(text);
        const original = button.textContent;
        button.textContent = 'Copied';
        setTimeout(() => (button.textContent = original), 1500);
      } catch {
        /* the field is selectable as a fallback */
      }
    };

    // ── Quote requests from the table pages ──
    type QuoteRequestData = {
      id: string; createdAt: string; status: string; productId: string; sizeId: string; order: string;
      postcode: string; name: string; email: string; phone: string; message: string;
    };
    let currentRequestId: string | null = null;
    const bannerEl = $('q-banner');
    const listEl = $('q-list');
    const listStatus = $('q-list-status');
    const loadBtn = $('q-load-request');
    const doneBtn = $('q-mark-done');
    const clearBtn = $('q-clear-request');

    const callRequests = async (body: Record<string, unknown>) => {
      if (!keyEl.value) throw new Error('Enter your passphrase first.');
      const response = await fetch('/.netlify/functions/quote-requests', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ key: keyEl.value, ...body }),
      });
      const data = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(data.error || 'Something went wrong.');
      try {
        sessionStorage.setItem('ld-quote-key', keyEl.value);
      } catch {
        /* fine */
      }
      return data;
    };

    const showBanner = (text: string, message = '', buttons: { load?: boolean; done?: boolean; clear?: boolean } = {}) => {
      bannerEl.classList.remove('hidden');
      $('q-banner-text').textContent = text;
      $('q-banner-message').textContent = message;
      loadBtn.classList.toggle('hidden', !buttons.load);
      doneBtn.classList.toggle('hidden', !buttons.done);
      clearBtn.classList.toggle('hidden', !buttons.clear);
    };

    const applyRequest = (r: QuoteRequestData) => {
      currentRequestId = r.id;
      productEl.value = r.productId;
      fillSizes();
      sizeEl.value = r.sizeId;
      $<HTMLInputElement>('q-postcode').value = r.postcode;
      $<HTMLInputElement>('q-for').value = r.name;
      $<HTMLInputElement>('q-email').value = r.email;
      showTotal();
      const contact = [r.email, r.phone].filter(Boolean).join(' · ');
      const status = r.status === 'quoted' ? ' (already quoted)' : '';
      showBanner(`Quote request from ${r.name}${status}: ${r.order} to ${r.postcode}. ${contact}`, r.message ? `"${r.message}"` : '', { done: true, clear: true });
      deliveryEl.focus();
      form.scrollIntoView({ behavior: 'smooth', block: 'start' });
    };

    const loadRequest = async (id: string) => {
      try {
        const data = await callRequests({ action: 'get', id });
        applyRequest(data.request);
      } catch (error) {
        showBanner(error instanceof Error ? error.message : 'Something went wrong.', '', { load: false, clear: true });
      }
    };

    const loadList = async () => {
      listStatus.textContent = 'Loading…';
      listEl.innerHTML = '';
      try {
        const data = await callRequests({ action: 'list' });
        const requests: QuoteRequestData[] = data.requests || [];
        listStatus.textContent = requests.length ? `${requests.length} open` : 'No open requests.';
        requests.forEach((r) => {
          const li = document.createElement('li');
          const button = document.createElement('button');
          button.type = 'button';
          button.className = 'w-full text-left px-4 py-3 rounded-lg border border-[#e8dcc8] hover:border-[#c8956a] text-sm text-[#3d4f47] cursor-pointer';
          const when = new Date(r.createdAt).toLocaleString('en-AU', { day: 'numeric', month: 'short', hour: 'numeric', minute: '2-digit' });
          button.textContent = `${when}: ${r.name}, ${r.order} to ${r.postcode}${r.status === 'quoted' ? ' (quoted)' : ''}`;
          button.dataset.requestId = r.id;
          button.addEventListener('click', () => applyRequest(r));
          li.appendChild(button);
          listEl.appendChild(li);
        });
      } catch (error) {
        listStatus.textContent = error instanceof Error ? error.message : 'Something went wrong.';
      }
    };

    $('q-load-list').addEventListener('click', loadList);
    loadBtn.addEventListener('click', () => {
      const id = new URLSearchParams(location.search).get('request');
      if (id) loadRequest(id);
    });
    clearBtn.addEventListener('click', () => {
      currentRequestId = null;
      bannerEl.classList.add('hidden');
    });
    doneBtn.addEventListener('click', async () => {
      if (!currentRequestId) return;
      try {
        await callRequests({ action: 'mark', id: currentRequestId, status: 'done' });
        showBanner('Marked as done. It no longer shows in the open requests.', '', { clear: true });
        // Changes can take a moment to show everywhere, so drop it from the list here rather than reloading it.
        const doneItem = listEl.querySelector(`[data-request-id="${currentRequestId}"]`);
        doneItem?.parentElement?.remove();
        currentRequestId = null;
      } catch (error) {
        showBanner(error instanceof Error ? error.message : 'Something went wrong.', '', { done: true, clear: true });
      }
    });

    // Opened from the notification email: /admin/quote/?request=<id>
    const requested = new URLSearchParams(location.search).get('request');
    if (requested) {
      if (keyEl.value) loadRequest(requested);
      else showBanner('Enter your passphrase, then load the quote request.', '', { load: true });
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!keyEl.value) {
        errorEl.textContent = 'Enter your passphrase first.';
        errorEl.classList.remove('hidden');
        return;
      }
      errorEl.classList.add('hidden');
      resultEl.classList.add('hidden');
      submitEl.disabled = true;
      submitEl.textContent = 'Creating…';
      try {
        const response = await fetch('/.netlify/functions/create-quote-link', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            key: keyEl.value,
            productId: productEl.value,
            sizeId: sizeEl.value,
            deliveryDollars: deliveryEl.value,
            postcode: $<HTMLInputElement>('q-postcode').value,
            quoteFor: $<HTMLInputElement>('q-for').value,
          }),
        });
        const data = await response.json().catch(() => ({}));
        if (!response.ok || !data.url) throw new Error(data.error || 'Something went wrong.');
        try {
          sessionStorage.setItem('ld-quote-key', keyEl.value);
        } catch {
          /* fine */
        }
        const name = $<HTMLInputElement>('q-for').value.trim();
        const postcode = $<HTMLInputElement>('q-postcode').value.trim();
        $('q-summary').textContent = `${data.order}: table ${money(data.tableCents)} + delivery ${money(data.deliveryCents)} = ${money(data.totalCents)}`;
        const mode = $('q-mode');
        mode.textContent = data.live ? 'Live link: real payments' : 'Test link: Stripe test mode only';
        mode.className = `text-xs font-medium uppercase tracking-wide ${data.live ? 'text-[#3d4f47]' : 'text-[#a15c1f]'}`;
        $<HTMLInputElement>('q-link').value = data.url;
        lastQuote = { url: data.url, productId: productEl.value, sizeId: sizeEl.value, deliveryDollars: deliveryEl.value, postcode };
        $('q-send-status').classList.add('hidden');
        $<HTMLButtonElement>('q-send').textContent = 'Send email to customer';
        $<HTMLTextAreaElement>('q-reply').value =
          `Hi${name ? ` ${name.split(' ')[0]}` : ''},\n\n` +
          `Thanks for your interest in the ${data.order}. Delivery${postcode ? ` to ${postcode}` : ''}, including assembly in your room, is ${money(data.deliveryCents)}, which makes the total ${money(data.totalCents)}.\n\n` +
          `Here is your secure payment link:\n${data.url}\n\n` +
          `Your table is made to order in Melbourne with a lead time of 6–8 weeks, and we'll be in touch to arrange delivery as it nears completion. Let me know if you have any questions.\n\nKind regards,\nLevel Design`;
        resultEl.classList.remove('hidden');
        resultEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      } catch (error) {
        errorEl.textContent = error instanceof Error ? error.message : 'Something went wrong.';
        errorEl.classList.remove('hidden');
      } finally {
        submitEl.disabled = false;
        submitEl.textContent = 'Create payment link';
      }
    });

    const sendEl = $<HTMLButtonElement>('q-send');
    const sendStatus = $('q-send-status');
    sendEl.addEventListener('click', async () => {
      if (!lastQuote) return;
      const toEmail = $<HTMLInputElement>('q-email').value.trim();
      const show = (message: string, ok: boolean) => {
        sendStatus.textContent = message;
        sendStatus.className = `text-sm ${ok ? 'text-[#3d4f47]' : 'text-red-700'}`;
      };
      if (!toEmail) return show("Enter the customer's email address first.", false);
      if (!confirm(`Email this quote to ${toEmail}?`)) return;
      sendEl.disabled = true;
      sendEl.textContent = 'Sending…';
      try {
        const response = await fetch('/.netlify/functions/send-quote-email', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            key: keyEl.value,
            ...lastQuote,
            toEmail,
            toName: $<HTMLInputElement>('q-for').value,
            note: $<HTMLTextAreaElement>('q-note').value,
            requestId: currentRequestId || undefined,
          }),
        });
        const data = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(data.error || 'Something went wrong.');
        show(`Sent to ${data.to}. A copy went to ${data.copyTo}.${currentRequestId ? ' The request is marked as quoted.' : ''}`, true);
        sendEl.textContent = 'Send again';
      } catch (error) {
        show(error instanceof Error ? error.message : 'Something went wrong.', false);
        sendEl.textContent = 'Send email to customer';
      } finally {
        sendEl.disabled = false;
      }
    });

    $('q-copy-link').addEventListener('click', (e) => copy($<HTMLInputElement>('q-link').value, e.currentTarget as HTMLElement));
    $('q-copy-reply').addEventListener('click', (e) => copy($<HTMLTextAreaElement>('q-reply').value, e.currentTarget as HTMLElement));
  }

  init();
  document.addEventListener('astro:page-load', init);
</script>
