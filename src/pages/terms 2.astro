---
import Layout from '../layouts/Layout.astro';
import { MELBOURNE_DELIVERY_CENTS } from '../data/delivery-zones';

const formatPrice = (cents: number) =>
  new Intl.NumberFormat('en-AU', { style: 'currency', currency: 'AUD', maximumFractionDigits: 0 }).format(cents / 100);

const deliveryZones = [
  { area: 'Melbourne Metro, the Mornington Peninsula and the Bass Coast', fee: formatPrice(MELBOURNE_DELIVERY_CENTS) },
  { area: 'Everywhere else, including Geelong, regional Victoria and interstate', fee: 'Quoted individually before you order' },
];

const sections: { title: string; paragraphs?: string[]; list?: string[] }[] = [
  {
    title: 'Who these terms are with',
    paragraphs: [
      'These terms apply to online orders for the Studio Collection placed through leveldesign.com.au with Level Design Australia Pty Ltd, ABN 85 633 988 486 ("Level Design", "we", "us"), Melbourne, Victoria.',
      'Signature Collection tables and custom commissions are quoted individually and are covered by the written quote and agreement we give you instead.',
    ],
  },
  {
    title: 'Price and payment',
    paragraphs: [
      'Prices are in Australian dollars. You pay the price of the table shown on its page, plus the delivery fee shown for your postcode before you pay. We are not currently registered for GST, so no GST is added.',
      'Payment is taken in full when you order and is processed securely by Stripe. We never see or store your card details.',
    ],
  },
  {
    title: 'Made to order',
    paragraphs: [
      'Every Studio table is made to order in Melbourne once you have ordered. We aim to complete your table within 6–8 weeks of your order, we will keep you updated, and we will tell you promptly if it is going to take longer.',
      'Oak is a natural material, so grain and colour vary from table to table. Photos, renders and 3D views are a guide, and your table may differ slightly from them. Natural variation in the timber is not a fault.',
    ],
  },
  {
    title: 'Changing or cancelling your order',
    paragraphs: [
      'If you need to change or cancel your order, contact us as soon as you can. You can change or cancel for a full refund within 48 hours of ordering, as long as we have not started work on your table.',
      'Because each table is made specifically for you, once we have started work we cannot offer a refund for a change of mind. If you are not sure whether work has started, just ask us.',
      'If we are unable to make or deliver your table, we will refund you in full.',
    ],
  },
  {
    title: 'Returns, faults and your consumer guarantees',
    paragraphs: [
      'Our goods come with guarantees that cannot be excluded under the Australian Consumer Law. You are entitled to a replacement or refund for a major failure and to compensation for any other reasonably foreseeable loss or damage. You are also entitled to have the goods repaired or replaced if they fail to be of acceptable quality and the failure does not amount to a major failure.',
      'If your table arrives damaged, or later develops a fault, reply to your order confirmation email, or send us a message through our contact page, with your order reference and some photos, and we will repair, replace or refund as the law requires.',
    ],
  },
  {
    title: 'Looking after your table',
    list: [
      'Wipe up spills promptly and clean with a soft, damp cloth, then dry.',
      'Use coasters, placemats and trivets, and avoid placing hot pots or dishes directly on the surface.',
      'Keep the table away from heaters and out of prolonged direct sunlight, which can change the colour of timber and cause it to move.',
      'Avoid harsh or abrasive cleaners.',
    ],
  },
  {
    title: 'Privacy',
    paragraphs: ['How we handle your personal information is set out in our Privacy Policy.'],
  },
  {
    title: 'Governing law',
    paragraphs: ['These terms are governed by the laws of Victoria, Australia.'],
  },
];
---

<Layout title="Terms of Sale | Level Design" description="Delivery, returns, cancellation and care for Studio Collection orders from Level Design, Melbourne.">
  <div>

    <!-- Hero -->
    <section class="relative pt-36 pb-16 bg-gradient-to-r from-[#3d4f47] to-[#2d3f37] text-white overflow-hidden">
      <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl">
          <p class="hero-in text-[#d9b48d] font-medium mb-4 tracking-wider uppercase text-sm" style="--delay: 0.2s">Terms of Sale</p>
          <h1 class="hero-in text-4xl md:text-5xl font-serif mb-4" style="--delay: 0.4s">Delivery, returns and care</h1>
          <p class="hero-in text-lg text-[#e8dcc8] leading-relaxed" style="--delay: 0.6s">
            The terms for Studio Collection orders. Last updated 8 October 2026.
          </p>
        </div>
      </div>
    </section>

    <section class="py-16 bg-white">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">

        {sections.slice(0, 3).map((section) => (
          <div>
            <h2 class="text-2xl font-serif text-[#3d4f47] mb-3">{section.title}</h2>
            {section.paragraphs?.map((text) => <p class="text-[#5a6b64] text-lg leading-relaxed mb-3">{text}</p>)}
          </div>
        ))}

        <div>
          <h2 class="text-2xl font-serif text-[#3d4f47] mb-3">Delivery</h2>
          <p class="text-[#5a6b64] text-lg leading-relaxed mb-4">The delivery fee is set from your delivery postcode and shown on the table's page before you pay.</p>
          <div class="rounded-2xl border border-[#e5ddd0] overflow-hidden mb-4">
            {deliveryZones.map((zone) => (
              <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-1 sm:gap-6 px-5 py-4 border-b border-[#e5ddd0] last:border-b-0 bg-[#faf8f5]">
                <span class="text-[#3d4f47]">{zone.area}</span>
                <span class="text-[#3d4f47] font-semibold sm:text-right">{zone.fee}</span>
              </div>
            ))}
          </div>
          <p class="text-[#5a6b64] text-lg leading-relaxed mb-3">
            If you are outside the area above, <a href="/contact/?topic=studio" class="text-[#c8956a] font-medium hover:underline">get in touch</a> before ordering and we will quote delivery for you.
          </p>
          <p class="text-[#5a6b64] text-lg leading-relaxed mb-3">
            If the address you enter at checkout is in a different delivery area to the postcode you entered on our site, we will contact you before we make your table to confirm the correct fee or, if you prefer, cancel your order for a full refund.
          </p>
          <p class="text-[#5a6b64] text-lg leading-relaxed mb-3">
            Each table is made in two parts, the top and the base, and is delivered that way. Delivery includes assembly: we put your table together in your room, so there is nothing for you to build.
          </p>
          <p class="text-[#5a6b64] text-lg leading-relaxed mb-3">
            We will contact you to arrange a delivery date as your table nears completion, and to confirm access details such as stairs, lifts, doorways and parking, so the top and the base can be brought in. Please inspect your table once it has been assembled. If anything is damaged or is not what you ordered, let us know within 7 days with photos so we can sort it out quickly. This does not limit your consumer guarantees below.
          </p>
        </div>

        {sections.slice(3).map((section) => (
          <div>
            <h2 class="text-2xl font-serif text-[#3d4f47] mb-3">{section.title}</h2>
            {section.paragraphs?.map((text) => (
              <p class="text-[#5a6b64] text-lg leading-relaxed mb-3">
                {text.includes('Privacy Policy') ? (
                  <>How we handle your personal information is set out in our <a href="/privacy/" class="text-[#c8956a] font-medium hover:underline">Privacy Policy</a>.</>
                ) : text}
              </p>
            ))}
            {section.list && (
              <ul class="space-y-3 text-[#5a6b64] text-lg">
                {section.list.map((item) => (
                  <li class="flex gap-3"><span class="text-[#c8956a] mt-1">•</span><span>{item}</span></li>
                ))}
              </ul>
            )}
          </div>
        ))}

        <div class="rounded-2xl bg-[#f5f1e8] p-6">
          <h2 class="text-xl font-serif text-[#3d4f47] mb-2">Contact</h2>
          <p class="text-[#5a6b64] leading-relaxed">
            Level Design Australia Pty Ltd · ABN 85 633 988 486<br />
            Melbourne, Victoria · <a href="/contact/?topic=studio" class="text-[#c8956a] font-medium hover:underline">Send us a message</a>, or reply to your order confirmation email
          </p>
        </div>

      </div>
    </section>

  </div>
</Layout>
