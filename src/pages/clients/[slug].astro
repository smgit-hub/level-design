---
import Layout from '../../layouts/Layout.astro';
import ModelViewer from '../../components/ModelViewer.astro';
import { clientProjects } from '../../data/client-projects';

export function getStaticPaths() {
  return clientProjects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
---

<Layout
  title={`${project.heading ?? 'Proposed Designs'} | ${project.clientName} | Level Design`}
  description={`Proposed 3D designs for ${project.clientName} from Level Design.`}
  ogImage={false}
  noindex
>
  <div>

    <!-- Hero -->
    <section class="relative bg-gradient-to-r from-[#3d4f47] to-[#2d3f37] text-white pt-36 pb-16 overflow-hidden">
      <div class="absolute inset-0 opacity-10">
        <div class="absolute top-0 right-0 w-96 h-96 bg-[#c8956a] rounded-full blur-3xl"></div>
      </div>
      <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl">
          <p class="hero-in text-[#c8956a] font-medium mb-4 tracking-wider uppercase text-sm" style="--delay: 0.2s">Prepared for {project.clientName}</p>
          <h1 class="hero-in text-4xl md:text-6xl font-serif" style="--delay: 0.4s">{project.heading ?? 'Your Proposed Designs'}</h1>
        </div>
      </div>
    </section>

    <section class="py-16 bg-[#f5f1e8]">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
        {project.pieces.map((piece, i) => {
          const details = Object.entries(piece.details ?? {});
          const title = piece.name ?? (project.pieces.length > 1 ? `Piece ${i + 1}` : undefined);
          return (
            <div class="reveal">
              {title && <h2 class="text-2xl md:text-3xl font-serif text-[#3d4f47] mb-4">{title}</h2>}
              <ModelViewer src={piece.model} studio autoRotate={false} textureToggle touchLock startDistance={piece.startDistance} />
              {details.length > 0 && (
                <div class="mt-4 p-4 md:p-6 bg-white rounded-xl">
                  <h3 class="font-medium text-[#3d4f47] mb-5">Details</h3>
                  <dl class="grid grid-cols-2 md:grid-cols-3 gap-x-6 gap-y-6">
                    {details.map(([key, value]) => (
                      <div class="border-t border-[#3d4f47]/15 pt-3">
                        <dt class="text-xs font-medium tracking-wider uppercase text-[#c8956a] mb-1">{key}</dt>
                        <dd class="text-lg font-serif text-[#3d4f47] leading-snug">{value}</dd>
                      </div>
                    ))}
                  </dl>
                </div>
              )}
              {piece.drawing && (
                <div class="mt-4 p-4 md:p-6 bg-white rounded-xl">
                  <div class="flex justify-between items-center gap-4 mb-4">
                    <h3 class="font-medium text-[#3d4f47]">Dimensions</h3>
                    {piece.drawingPdf && (
                      <a href={piece.drawingPdf} target="_blank" rel="noopener" class="text-sm text-[#c8956a] hover:text-[#3d4f47] transition-colors">Download PDF</a>
                    )}
                  </div>
                  <a href={piece.drawingPdf ?? piece.drawing} target="_blank" rel="noopener">
                    <img src={piece.drawing} alt={`Dimension drawing of the ${(title ?? project.heading ?? 'piece').toLowerCase()}`} width="1191" height="842" loading="lazy" class="w-full h-auto" />
                  </a>
                </div>
              )}
            </div>
          );
        })}
      </div>
    </section>

    <section class="py-20 bg-white">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="reveal text-3xl font-serif text-[#3d4f47] mb-4">Questions or changes?</h2>
        <p class={`reveal text-[#5a6b64] text-lg ${project.contactButton === false ? '' : 'mb-8'}`}>{project.closingText ?? "Let us know what you'd like adjusted and we'll update the designs."}</p>
        {project.contactButton !== false && (
          <a href="/contact/" class="reveal btn-scale inline-flex items-center gap-2 px-8 py-4 bg-[#3d4f47] text-white rounded-full hover:bg-[#2d3f37] transition-all duration-300 shadow-lg hover:shadow-xl">
            Get in Touch
          </a>
        )}
      </div>
    </section>

  </div>
</Layout>
