---
import Navigation from '../components/Navigation';
import Footer from '../components/Footer.astro';
import { ViewTransitions } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  preloadImage?: string;
  ogImage?: string;
  ogType?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = 'Level Design',
  description = 'Handcrafted timber dining tables designed and made in Melbourne, Australia. 9 signature designs, fully customisable to your space.',
  preloadImage,
  ogImage = '/images/home/level-design-handcrafted-furniture-hero.webp',
  ogType = 'website',
  schema,
} = Astro.props;

const currentPath = Astro.url.pathname;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const siteURL = Astro.site ?? new URL(Astro.url.origin);
const ogImageURL = new URL(ogImage, siteURL);
const googleBusinessProfileURL = 'https://share.google/2X8cmzgsefNsOyp1a';
const businessSchemaId = new URL('/#level-design', siteURL).toString();
const baseSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': businessSchemaId,
  name: 'Level Design',
  legalName: 'Level Design',
  alternateName: 'Level Design Melbourne',
  url: siteURL.toString(),
  image: new URL('/images/home/level-design-handcrafted-furniture-hero.webp', siteURL).toString(),
  logo: new URL('/images/level-logo.png', siteURL).toString(),
  description,
  areaServed: [
    { '@type': 'City', name: 'Melbourne' },
    { '@type': 'AdministrativeArea', name: 'Victoria' },
    { '@type': 'Country', name: 'Australia' },
  ],
  sameAs: [
    googleBusinessProfileURL,
    'https://www.facebook.com/leveldesignmelbourne/',
    'https://www.instagram.com/level_design/',
  ],
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Melbourne',
    addressRegion: 'VIC',
    addressCountry: 'AU',
  },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Custom timber dining tables Melbourne',
    itemListElement: [
      {
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: 'Custom dining tables Melbourne',
          serviceType: 'Bespoke timber dining table design',
          areaServed: { '@type': 'City', name: 'Melbourne' },
        },
      },
      {
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Product',
          name: 'Handcrafted timber dining tables',
          category: 'Furniture',
          areaServed: { '@type': 'AdministrativeArea', name: 'Victoria' },
        },
      },
    ],
  },
  brand: {
    '@type': 'Brand',
    name: 'Level Design',
  },
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'customer service',
    url: new URL('/contact/', siteURL).toString(),
    areaServed: 'AU',
    availableLanguage: 'en',
  },
};
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': new URL('/#website', siteURL).toString(),
  name: 'Level Design',
  alternateName: 'Level Design Melbourne',
  url: siteURL.toString(),
  publisher: {
    '@id': businessSchemaId,
  },
  inLanguage: 'en-AU',
};
const schemaNodes = [baseSchema, websiteSchema, ...(Array.isArray(schema) ? schema : schema ? [schema] : [])];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <title>{title}</title>
    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:site_name" content="Level Design" />
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {preloadImage && <link rel="preload" as="image" href={preloadImage} />}
    <link rel="apple-touch-icon" href="/favicon-circle.png" />
    <link rel="me" href={googleBusinessProfileURL} />
    {schemaNodes.map((node) => (
      <script type="application/ld+json" set:html={JSON.stringify(node)} />
    ))}
    <ViewTransitions />
    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-7FGDPXHPK5"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-7FGDPXHPK5');
    </script>
  </head>
  <body class="bg-[#f5f1e8] text-[#3d4f47]">
    <Navigation client:load currentPath={currentPath} transition:persist />
    <div class="overflow-x-hidden">
      <main>
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>

<script>
  // Intersection Observer for scroll-reveal animations
  function initReveal() {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.12 }
    );
    document.querySelectorAll('.reveal, .reveal-left, .reveal-right').forEach((el) => {
      observer.observe(el);
    });
  }
  document.addEventListener('astro:page-load', initReveal);

  // Hero parallax: fade + scale out as user scrolls past
  let heroScrollHandler: (() => void) | null = null;
  function initHeroParallax() {
    if (heroScrollHandler) window.removeEventListener('scroll', heroScrollHandler);
    const hero = document.querySelector<HTMLElement>('.hero-parallax');
    if (!hero) return;
    heroScrollHandler = () => {
      const progress = Math.max(0, Math.min(1, -hero!.getBoundingClientRect().top / hero!.offsetHeight));
      hero!.style.opacity = String(1 - progress);
      hero!.style.transform = `scale(${1 - progress * 0.2})`;
    };
    window.addEventListener('scroll', heroScrollHandler, { passive: true });
    heroScrollHandler();
  }
  document.addEventListener('astro:page-load', initHeroParallax);
</script>
