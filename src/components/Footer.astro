---
const year = new Date().getFullYear();
---

<footer class="bg-[#2d3f37] text-[#e8dcc8]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-8">

      <!-- Brand -->
      <div class="space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-full bg-[#e8dcc8] flex items-center justify-center p-1.5">
            <svg viewBox="0 0 40 40" class="w-full h-full text-[#3d4f47]" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="8" y="8" width="24" height="24" rx="2" />
              <line x1="20" y1="8" x2="20" y2="32" />
              <line x1="8" y1="20" x2="32" y2="20" />
            </svg>
          </div>
          <span class="text-white text-lg font-semibold">Level Design</span>
        </div>
        <p class="text-sm text-[#b8ac98]">
          Design-led timber tables made for everyday living, hosting, and lasting use.
        </p>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="text-white font-semibold mb-4">Quick Links</h3>
        <ul class="space-y-2">
          {[
            { href: '/', label: 'Home' },
            { href: '/tables', label: 'Tables' },
            { href: '/custom', label: 'Custom' },
            { href: '/about', label: 'About' },
          ].map(({ href, label }) => (
            <li>
              <a href={href} class="text-sm hover:text-white transition-colors">{label}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Support -->
      <div>
        <h3 class="text-white font-semibold mb-4">Support</h3>
        <ul class="space-y-2">
          {[
            { href: '/contact', label: 'Contact Us' },
            { href: '/privacy', label: 'Privacy Policy' },
          ].map(({ href, label }) => (
            <li>
              <a href={href} class="text-sm hover:text-white transition-colors">{label}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Newsletter -->
      <div>
        <h3 class="text-white font-semibold mb-4">Stay Updated</h3>
        <p class="text-sm text-[#b8ac98] mb-4">Subscribe to get special offers and updates</p>
        <form class="space-y-2">
          <input
            type="email"
            placeholder="Your email"
            class="w-full px-4 py-2 rounded-lg bg-[#3d4f47] text-white placeholder-[#b8ac98] border border-[#4d5f57] focus:border-[#c8956a] focus:outline-none transition-colors"
          />
          <button
            type="submit"
            class="w-full px-4 py-2 bg-[#c8956a] text-white rounded-lg hover:bg-[#b8856a] transition-colors"
          >
            Subscribe
          </button>
        </form>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 border-t border-[#3d4f47] flex flex-col sm:flex-row justify-between items-center gap-4">
      <p class="text-sm text-[#b8ac98]">© {year} Level Design. All rights reserved.</p>
      <div class="flex gap-4">
        <a
          href="#"
          class="w-10 h-10 rounded-full bg-[#3d4f47] flex items-center justify-center hover:bg-[#4d5f57] transition-colors"
          aria-label="Facebook"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z" />
          </svg>
        </a>
        <a
          href="#"
          class="w-10 h-10 rounded-full bg-[#3d4f47] flex items-center justify-center hover:bg-[#4d5f57] transition-colors"
          aria-label="Instagram"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5" />
            <circle cx="12" cy="12" r="4" />
            <circle cx="17.5" cy="6.5" r="0.5" fill="currentColor" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</footer>
